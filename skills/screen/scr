def find(items, target, nth=0):
    if re.fullmatch(r"s\d+", target):
        i = int(target[1:]) - 1
        return [items[i]] if 0 <= i < len(items) else []
    t = target.strip()
    exact = [it for it in items if it[0] == t]
    if exact:
        return exact
    return [it for it in items if t and t in it[0]]


def show_cands(c, target):
    print(f"✘ 无法确定 “{target}”，命中 {len(c)} 个，先看清楚再点：")
    for i, it in enumerate(c[:6], 1):
        print(f"  s{i}  {it[0][:30]} @{it[1]['center']['x']},{it[1]['center']['y']}")


def tap_node(n, items_index=None):
    r = a11y("tap", "node", n["nodeId"])
    if r.get("ok"):
        return "node"
    c = n["center"]
    r = a11y("tap", "xy", str(c["x"]), str(c["y"]))
    return "xy" if r.get("ok") else "fail"


