#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""scr — 看一次，动一次，验一次。

根本目的：让 AI 用最少的回合把这台手机上的事做完，而且不点错。
用法要点（细节见同目录 SKILL.md）：
    scr look            看现在这一屏（节点有内容就给节点，没内容自动给截图）
    scr tap 文字        找到它、点它、等页面稳定、把新一屏回给你
    scr xy 540 1200     点设备像素（图上红字刻度就是设备像素，直接抄）
    scr type 文本       往焦点输入框写字
    scr key back        返回/主页/通知栏
    scr open 微信       启动应用
    scr do "tap:微信" "wait:发送" ...
所有动作用完都自带"变没变"的结论，绝大多数步骤不需要再单独看一次。
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time

WORK = "/var/minis/workspace/shots"     # 过程件，按需保留最近几张
KEEP = 2
SYS = "com.android.systemui"
TILE_WORDS = ("截屏", "屏幕截图", "Screenshot")
EDITOR_HINTS = ("multiscreenshot", "screenshot", "hwscreenshot")

# ---------- 设备档案（换机改这里 + 删 device.json） ----------
DEVFILE = "/var/minis/skills/screen/device.json"
# 本机：Android 17 机型（4 列 6 行 + Dock），换机用 scr doctor --save 重测
DEV_DEFAULT = {"w": 1280, "h": 2772, "scale": 0.5, "cols": 4, "rows": 6,
               "launcher": "com.miui.home",
               # 实测（look 报出的节点中心，列距 301、行距 326）：旧值 227/502/777/1052、
               # 560/858…是等分算出来的假坐标，按它点会偏到邻格。
               "grid_x": [188, 489, 790, 1091],
               "grid_y": [407, 733, 1059, 1385, 1711, 2037]}
# 屏幕顶部这个比例以内的"下滑"会被系统当成下拉通知/搜索——拖拽起点必须避开，
# 否则手势被 systemui 吃掉，看起来像"没反应"（踩过两次）。
TOP_DEAD = 0.15


def dev():
    d = dict(DEV_DEFAULT)
    try:
        d.update({k: v for k, v in (json.load(open(DEVFILE)) or {}).items() if v})
    except Exception:                                          # noqa: BLE001
        pass
    return d


def save_dev(d):
    try:
        json.dump(d, open(DEVFILE, "w"), ensure_ascii=False, indent=1)
    except Exception:                                          # noqa: BLE001
        pass


def screen_size():
    """屏幕像素。(w, h)

    从 ui dump 里面积最大的那个整屏节点反推（它的 center 就是屏幕中心），
    读不到才退回档案值。为什么不问截图元数据：那要多花 1.5–3s，而 dump 反正要做。
    """
    d = dev()
    try:
        nodes = _LAST["nodes"] or raw_nodes()
        best = max(nodes, key=lambda n: area(n["bounds"]))
        w, h = best["center"]["x"] * 2, best["center"]["y"] * 2
        if w > 400 and h > 800:
            # 只信"接近档案值"的测量：前台是悬浮窗/分屏/键盘弹出时，最大节点只是那个窗口，
            # 直接落盘会把 1280×2114 这种尺寸永久写进 device.json，之后整屏过滤全错。
            dw, dh = d["w"], d["h"]
            if abs(w - dw) / dw <= 0.03 and abs(h - dh) / dh <= 0.03:
                if (w, h) != (dw, dh):
                    d.update({"w": w, "h": h})
                    save_dev(d)
            return w, h
    except Exception:                                          # noqa: BLE001
        pass
    return d["w"], d["h"]


# ---------- 与设备对话 ----------
def a11y(*args, t=15):
    try:
        p = subprocess.run(["android-a11y-cli", *args], capture_output=True, text=True, timeout=t)
        out = p.stdout.strip()
        if out.startswith("{"):
            d = json.loads(out)
            e = d.get("error")
            if isinstance(e, str):        # 参数错时 CLI 返回 {"error":"invalid_args","message":...}
                d["error"] = {"code": e.upper(), "message": d.get("message", "")}
            return d
        return {"ok": False, "error": {"code": "NO_JSON", "message": (out + p.stderr)[:200]}}
    except Exception as e:                                    # noqa: BLE001
        return {"ok": False, "error": {"code": "EXC", "message": str(e)[:160]}}


def die(d):
    e = d.get("error") or {}
    code = e.get("code", "ERROR")
    msg = e.get("message", "")
    hint = {
        "SERVICE_NOT_RUNNING": "无障碍没开：让用户去 设置→无障碍 打开 Minis（用户自己操作手机时会关掉它）",
        "PERMISSION_DENIED": "Minis 的 Agent 授权没给，去 设置→权限",
    }.get(code, "")
    print(f"✘ {code} {msg}" + (f"\n  {hint}" if hint else ""))
    sys.exit(2)


def info():
    for _ in range(3):
        d = a11y("ui", "info")
        data = (d.get("data") or {}) if d.get("ok") else {}
        if data.get("packageName"):
            return data
        time.sleep(0.1)
    return data


_LAST = {"nodes": []}


_SCRN = {}


def _scrn():
    """屏幕尺寸缓存：过滤越界节点要用，不该每次都去问系统。"""
    if not _SCRN:
        # 不能走 screen_size()：它读不到节点时会回头调 raw_nodes()，递归。
        d = dev()
        _SCRN["w"], _SCRN["h"] = d["w"], d["h"]
    return _SCRN["w"], _SCRN["h"]


def _drop_offscreen(nodes):
    """过渡帧（页面还在滑入）会把整棵树平移一整屏：Settings 页曾报
    返回@1400、扫描二维码@2452，正好 +1280。这种坐标点下去必然打偏，
    宁可当作"这一屏没东西"重新取，也不能把它当真实位置交出去。"""
    W, H = _scrn()
    keep = []
    for n in nodes:
        c = n.get("center") or {}
        x, y = c.get("x"), c.get("y")
        if x is None or y is None:
            keep.append(n)
        elif 0 <= x < W and 0 <= y < H:
            keep.append(n)
    return keep


def raw_nodes(retry=4):
    """取节点树。空树/整树越界（页面切换动画中）就重取，最多 retry 次。
    MIUI 桌面刚回 home、刚翻页时会有 0.3–1s 只返回状态栏的空窗期，
    老版本把这个空窗当成"这一屏没有东西"，于是 open 打出「0 项」。"""
    nodes = []
    for i in range(retry):
        d = a11y("ui", "dump")
        if not d.get("ok"):
            die(d)
        nodes = _drop_offscreen(d["data"]["nodes"] or [])
        if i == retry - 1:
            break
        # 只剩状态栏（<4 个节点）或整树被丢掉：说明页面还没落定
        if len(nodes) < 4:
            time.sleep(0.12)
            continue
        break
    _LAST["nodes"] = nodes
    return nodes


# ---------- 把节点树压成"一屏能读完"的清单 ----------
NOISE = {"按钮", "标签", "图片", "开关", "复选框", "单选按钮", "选项卡", "图标"}


def clean_desc(d):
    """contentDesc 里塞满了 "按钮/标签/7之3" 这类读屏口水，先榨干再当标签。"""
    out = []
    for p in re.split(r"[，,、]", d):
        p = p.strip()
        if not p or p in NOISE or re.fullmatch(r"\d+之\d+|第\d+项|\d+条未读", p):
            continue
        p = re.sub(r"^(按钮|标签|图标)\s*[·.]?\s*", "", p)
        out.append(p)
    return " / ".join(out)


def lbl(n):
    t = (n.get("text") or "").strip()
    if not t:
        t = clean_desc((n.get("contentDesc") or "").strip())
    return re.sub(r"\s+", " ", t)[:60]


def area(b):
    return max(0, b["right"] - b["left"]) * max(0, b["bottom"] - b["top"])


def inside(o, i):
    return (o["left"] <= i["left"] and o["top"] <= i["top"]
            and o["right"] >= i["right"] and o["bottom"] >= i["bottom"])


def build(nodes):
    """把节点树压成"一行一个能点的东西"：按钮自己的文字当标题，副标题并进去。"""
    H = max([n["bounds"]["bottom"] for n in nodes] + [2400])
    W = max([n["bounds"]["right"] for n in nodes] + [1080])
    vis = [n for n in nodes
           if n["bounds"]["top"] > H * 0.045        # 状态栏：时间/网速每秒在变，会把"变了没"污染成永远"变了"
           and n["bounds"]["bottom"] < H * 0.985    # 底部手势条
           and area(n["bounds"]) > 0]
    full = 0.55 * W * H
    texts = [n for n in vis if lbl(n)]
    tgts = [n for n in vis
            if (n["clickable"] or n["editable"] or n["checkable"])
            and (lbl(n) or area(n["bounds"]) >= 4000)
            and area(n["bounds"]) < full]

    rows, taken, shells = [], set(), []
    for t in sorted(tgts, key=lambda n: (n["center"]["y"], n["center"]["x"])):
        if id(t) in taken:
            continue
        if any(inside(s, t["bounds"]) and not lbl(t) for s in shells):
            continue                      # 没有自己文字的大容器套小容器：只报外层
        parts, last = [], None
        for x in sorted([x for x in texts if inside(t["bounds"], x["bounds"])],
                        key=lambda n: (n["bounds"]["top"], n["bounds"]["left"])):
            if id(x) in taken or lbl(x) == last:
                continue
            parts.append(lbl(x))
            taken.add(id(x))
            last = lbl(x)
        rows.append([" · ".join(parts[:2])[:46], t])
        taken.add(id(t))
        shells.append(t["bounds"])

    # 没被任何按钮收走的文字（正文、说明、列表条目）：留前 8 条当上下文
    used = [r[1]["bounds"] for r in rows]
    spare = [x for x in texts if id(x) not in taken
             and not any(inside(b, x["bounds"]) for b in used)]
    for x in spare[:8]:
        rows.append([lbl(x)[:46], x])

    # 没文字的可点控件（开关、箭头、图标）：在自己上下找原来的标题贴上去
    clickables = [n for n in vis if n["clickable"] or n["editable"] or n["checkable"]]
    for r in rows:
        n = r[1]
        if n["clickable"] or n["editable"] or n["checkable"]:
            continue
        b, h = n["bounds"], n["bounds"]["bottom"] - n["bounds"]["top"]
        near = [t for t in clickables if not lbl(t)
                and abs(t["center"]["y"] - n["center"]["y"]) < max(h * 2, 220)
                and (t["center"]["x"] < b["left"] or t["center"]["x"] > b["right"])]
        if near:
            r[1] = min(near, key=lambda t: abs(t["center"]["y"] - n["center"]["y"]))

    short = [x for x in texts if len(lbl(x)) <= 18]
    for r in rows:
        n = r[1]
        if lbl(n) or not (n["clickable"] or n["checkable"] or n["editable"]):
            continue
        pool = [x for x in (short or texts)
                if abs(x["center"]["y"] - n["center"]["y"]) < 200
                and x["center"]["x"] <= n["center"]["x"]]
        if pool:
            r[0] = lbl(min(pool, key=lambda x: abs(x["center"]["y"] - n["center"]["y"])))[:46]

    # 同一横条上重复的标签（读屏把同一个 tab 报了两遍）：留最左边那个
    seen = {}
    for r in rows:
        k = (r[0], r[1]["center"]["y"] // 40)
        if r[0] and k in seen:
            continue
        if r[0]:
            seen[k] = r
    rows = [r for r in rows if not r[0] or seen.get((r[0], r[1]["center"]["y"] // 40)) is r]

    # 同一控件被多行认领：留最上面那条（标题在上、说明在下）
    by_node = {}
    for r in rows:
        k = r[1]["nodeId"]
        if k not in by_node or r[1]["center"]["y"] <= by_node[k][1]["center"]["y"]:
            by_node[k] = r
    return sorted(by_node.values(), key=lambda x: (x[1]["center"]["y"] // 26, x[1]["center"]["x"]))


def sig(items):
    s = "|".join(f"{l}:{n['center']['x']}:{n['center']['y']}:{int(n['clickable'])}:"
                 f"{int(n['checkable'] and n['checked'])}" for l, n in items)
    return hashlib.md5(s.encode()).hexdigest()[:8]


def render(items):
    rows = []
    for i, (label, n) in enumerate(items, 1):
        f = "E" if n["editable"] else ("C" if n["clickable"] else "·")
        if n["checkable"]:
            f += "✔" if n["checked"] else "☐"
        if n["scrollable"]:
            f += "↕"
        c = n["center"]
        if not label and n["clickable"]:       # 桌面上文件夹节点没有文字，别显示成空白
            label = "(文件夹)"
        rows.append(f"s{i} {f:<3}{label[:44]} @{c['x']},{c['y']}")
    return "\n".join(rows)


def page_title(nodes):
    cand = [n for n in nodes
            if (n.get("text") or "").strip() and 110 < n["center"]["y"] < 330
            and len(lbl(n)) <= 24 and n["packageName"] != SYS
            and n["bounds"]["right"] - n["bounds"]["left"] > 180]
    return lbl(cand[0]) if cand else ""


def emit(items, pkg, nodes=None):
    """默认把这一屏完整打印出来；链式执行时中间步骤只留一行结论。"""
    if os.environ.get("SCR_QUIET"):
        return
    print(head_for(pkg, items, nodes))
    print(render(items))


LASTLOOK = os.path.join(WORK, "lastlook.json")


def remember_look(s):
    try:
        os.makedirs(WORK, exist_ok=True)
        json.dump({"sig": s, "ts": int(time.time())}, open(LASTLOOK, "w"))
    except OSError:
        pass


def look_stale(s_now, max_age=180):
    """`sN` 是"上一次 look 的第 N 项"，换了屏就作废——不比对就像拿旧门牌号开新门。"""
    try:
        st = json.load(open(LASTLOOK))
    except Exception:                                          # noqa: BLE001
        return "没有可用的 look 记录（先 scr look 一次）"
    if st.get("sig") != s_now:
        return "这一屏已经变了，sN 序号作废"
    if time.time() - st.get("ts", 0) > max_age:
        return f"上次 look 已超过 {max_age}s"
    return None


def snap():
    nodes = raw_nodes()
    items = build(nodes)
    return items, sig(items), (info().get("packageName") or "?"), nodes


def header(pkg, items, extra=""):
    h = f"app {pkg} · {len(items)} 项" + (f" · {extra}" if extra else "")
    return h


def head_for(pkg, items, nodes=None):
    t = page_title(nodes if nodes is not None else _LAST["nodes"])
    return f"app {pkg}｜{t}｜{len(items)} 项" if t else f"app {pkg}｜{len(items)} 项"


# ---------- 像素 ----------
def photos(limit=1):
    """查相册。失败返回 None——空列表代表"真的没有"，两者必须分开，
    否则"查不到相册"会被说成"没有新截图"，把排查方向带偏。"""
    try:
        p = subprocess.run(["android-photos", "list", "--limit", str(limit)],
                           capture_output=True, text=True, timeout=20)
        media = json.loads(p.stdout)["media"]
        return media if isinstance(media, list) else None
    except Exception:                                          # noqa: BLE001
        return None


def find_tile(nodes):
    for n in nodes:
        t = (n.get("contentDesc") or "") + (n.get("text") or "")
        if any(w in t for w in TILE_WORDS) and n["bounds"]["top"] < 900 and n["clickable"]:
            return n
    return None


SECURE_DB = os.path.join(WORK, "secure.json")
SHOT_NAME = re.compile(r"^Screenshot_(\d{8})_(\d{6})\.(?:jpg|jpeg|png)$", re.I)
LEFTOVER = [""]          # 没删掉的那张，收尾时提一句


def secure_map():
    try:
        return json.load(open(SECURE_DB))
    except Exception:                                          # noqa: BLE001
        return {}


def mark_secure(pkg, flag=True):
    m = secure_map()
    if flag:
        m[pkg] = int(time.time())
    else:
        m.pop(pkg, None)
    os.makedirs(WORK, exist_ok=True)
    json.dump(m, open(SECURE_DB, "w"))


SECURE_HINTS = ("secure", "privacy", "隐私", "禁止截图", "不允许截屏", "black")
SHOT_SEQ = [0]


def _ruler(im, d):
    """在缩略图上画设备像素刻度：细线每 200px，左上两侧标数字每 400px。

    目的：**只保留一套坐标**。模型看的是 640×1386 的图，但图上每格都标着设备像素值，
    所以"读图 → 给 xy"全程都是设备像素，不再有 ×2 换算，也不会两套坐标打架。
    """
    try:
        from PIL import ImageDraw
        dr = ImageDraw.Draw(im)
        sc = d["scale"]
        for x in range(200, d["w"], 200):
            px = int(x * sc)
            dr.line([(px, 0), (px, im.height)], fill=(185, 185, 185), width=1)
        for y in range(200, d["h"], 200):
            py = int(y * sc)
            dr.line([(0, py), (im.width, py)], fill=(185, 185, 185), width=1)
        for x in range(400, d["w"], 400):
            dr.text((int(x * sc) + 2, 2), str(x), fill=(220, 0, 0))
        for y in range(400, d["h"], 400):
            dr.text((2, int(y * sc) + 1), str(y), fill=(220, 0, 0))
    except Exception:                                          # noqa: BLE001
        pass


def _shrink(src, keep_full=False):
    """统一缩到"屏幕 × device.scale"（这台是 1280×2772 → 640×1386），并**删掉原图**。

    三条都必须做，少一条就会堆缓存（2026-11-16 实测堆到 182 张 / 124 MB）：
      1. 原图只用一次，缩完立刻 os.remove —— 旧的通知栏路径本来就有这行，换通道时丢了；
      2. 小图存 JPEG(80)，不要 PNG：单张 120KB vs 670KB，差 5 倍；
      3. 小图按 KEEP 保留最近几张，因为要留给"点之前/点之后"两张做对比。
    """
    os.makedirs(WORK, exist_ok=True)
    d = dev()
    tw, th = int(d["w"] * d["scale"]), int(d["h"] * d["scale"])
    SHOT_SEQ[0] += 1
    small = os.path.join(WORK, f"view_{int(time.time()*1000)}_{SHOT_SEQ[0]}.jpg")
    try:
        from PIL import Image
        im = Image.open(src).convert("RGB")
        if im.size != (tw, th):
            im = im.resize((tw, th), Image.LANCZOS)
        _ruler(im, d)
        im.save(small, "JPEG", quality=80)
        if keep_full:
            im.save(os.path.join(WORK, "full_" + os.path.basename(small)), "JPEG", quality=92)
        ok = True
    except Exception as e:                                     # noqa: BLE001
        # 缩图失败就别返回 src：finally 会把 src 删掉，返回一条已不存在的路径
        # 会让上层把 404 链接交给模型（PIL 缺失/图损坏/磁盘满时都可能）。
        print(f"… 缩图失败：{type(e).__name__}: {e}")
        return None
    finally:
        # 原图（无障碍 takeScreenshot 落在 attachments/screenshots/ 的那张）用完即删
        if 'ok' in dir() and src != small:
            try:
                os.remove(src)
            except OSError:
                pass
    prune()
    return small


PRUNE_OK = re.compile(r"^(view|shot|full|prev)[_\w-]*\.(jpg|png)$")


def prune():
    """只删自己拍的历史截图，别的一律不动。

    WORK 里同时住着 lastlook.json（sN 记录）和 secure.json（哪些 App 禁截屏）：
    按 mtime 无差别删会把它们清掉，于是 sN 保护失效、"禁截屏"缓存每轮重试。
    """
    try:
        fs = [f for f in os.listdir(WORK) if PRUNE_OK.match(f)]
        fs.sort(key=lambda x: os.path.getmtime(os.path.join(WORK, x)))
        for f in fs[:-KEEP * 2]:
            try:
                os.remove(os.path.join(WORK, f))
            except OSError:
                pass
    except Exception:                                          # noqa: BLE001
        pass


def shot(keep_full=False):
    """截一张图，返回 (看图路径, 错误码)。

    首选无障碍 takeScreenshot（1.5–3s，不碰相册、不依赖通知栏磁贴）。
    旧实现走"拉通知栏点截屏磁贴 + 相册取图"，这台机的通知栏里根本没有那个磁贴，
    直接 NO_TILE；保留成 shot_tile 只作兜底。
    """
    front = info().get("packageName", "")
    if time.time() - secure_map().get(front, 0) < 3600:
        return None, "SECURE"
    d = a11y("ui", "screenshot", t=25)
    if d.get("ok"):
        src = ((d.get("data") or {}).get("path")) or ""
        if src and os.path.exists(src):
            small = _shrink(src, keep_full)
            return (small, None) if small else (None, "SHRINK_FAILED")
        return None, "NO_PATH"
    err = json.dumps(d.get("error") or {}, ensure_ascii=False)
    if any(h in err.lower() for h in SECURE_HINTS):
        mark_secure(front)
        return None, "SECURE"
    path, e2 = shot_tile(keep_full)
    if path:
        return path, None
    code = (d.get("error") or {}).get("code", "A11Y_FAIL")
    return None, f"{code}/{e2}"


def shot_tile(keep_full=False):
    os.makedirs(WORK, exist_ok=True)
    front = info().get("packageName", "")
    if time.time() - secure_map().get(front, 0) < 3600:
        return None, "SECURE"
    nodes = raw_nodes()
    tile = find_tile(nodes)
    if not tile:                       # 通知栏没开
        a11y("input", "key", "notifications")
        for _ in range(8):
            time.sleep(0.12)
            nodes = raw_nodes()
            tile = find_tile(nodes)
            if tile:
                break
    if not tile:
        return None, "NO_TILE"
    last = photos(1)
    if last is None:
        return None, "PHOTO_DB_UNREADABLE"      # 查不到相册：和"没出图"是两回事
    last_id = last[0]["id"] if last else 0
    a11y("tap", "node", tile["nodeId"])
    t0 = time.time()
    found = None
    while time.time() - t0 < 5:
        m = photos(1)
        if m is None:
            return None, "PHOTO_DB_UNREADABLE"
        if m and m[0]["id"] > last_id and SHOT_NAME.match(m[0].get("name") or ""):
            found = m[0]
            break
        time.sleep(0.15)
    if not found:
        # 没落盘通常是系统拒绝截屏（App 开了截屏保护）。查通知栏确认，别猜。
        a11y("input", "key", "notifications")
        time.sleep(0.7)
        denied = False
        try:
            for n in raw_nodes():
                t = (n.get("text") or "") + (n.get("contentDesc") or "")
                if "隐私" in t or "无法捕获" in t or "不允许截屏" in t:
                    denied = True
                    break
        except Exception:                                      # noqa: BLE001
            pass
        a11y("input", "key", "back")
        if denied:
            mark_secure(front)
            return None, "SECURE"
        return None, "NO_NEW_SHOT"
    p = subprocess.run(["android-photos", "export", "--id", str(found["id"]),
                        "--size", "original"], capture_output=True, text=True)
    try:
        src = json.loads(p.stdout)["linux_path"]
    except Exception:                                          # noqa: BLE001
        return None, f"EXPORT_FAIL: {(p.stdout or p.stderr).strip()[:120]}"
    dst = os.path.join(WORK, f"shot_{found['id']}.jpg")
    small = os.path.join(WORK, f"view_{found['id']}.jpg")
    try:
        from PIL import Image
        im = Image.open(src).convert("RGB")
        w, h = im.size
        im.resize((w // 2, h // 2), Image.LANCZOS).save(small, "JPEG", quality=80)
        if keep_full:
            im.save(dst, "JPEG", quality=88)
        os.remove(src)
    except Exception as e:                                     # noqa: BLE001
        return None, f"PIL {e}"
    for f in sorted(os.listdir(WORK), key=lambda x: os.path.getmtime(os.path.join(WORK, x)))[:-KEEP * 2]:
        try:
            os.remove(os.path.join(WORK, f))
        except OSError:
            pass
    # 只按这一张的 id 删一次；删没删掉以 deleted_count 为准，不信"看起来删了"。
    # 删不掉就把 id 和文件名交出去，由调用方判断，不在这里反复重试。
    r = subprocess.run(["android-photos", "delete", "--ids", str(found["id"]),
                        "--confirm"], capture_output=True, text=True)
    try:
        n = int(json.loads(r.stdout or "{}").get("deleted_count") or 0)
    except Exception:                                          # noqa: BLE001
        n = 0
    LEFTOVER[0] = "" if n >= 1 else f'{found["name"]}(id={found["id"]})'
    # 万一系统截屏编辑器抢了前台，退掉
    wk = info().get("packageName", "")
    if any(h in wk.lower() for h in EDITOR_HINTS):
        a11y("input", "key", "back")
        time.sleep(0.2)
    return small, None


def diff(path_new, path_old):
    try:
        from PIL import Image, ImageChops, ImageStat
        a = Image.open(path_new).convert("L")
        b = Image.open(path_old).convert("L").resize(a.size)
        w, h = a.size
        box = (0, int(h * 0.06), w, int(h * 0.98))   # 状态栏时钟/网速每秒都变，算进去会假阳
        a, b = a.crop(box), b.crop(box)
        st = ImageStat.Stat(ImageChops.difference(a, b))
        return round(sum(st.mean) / len(st.mean) / 255 * 100, 1)
    except Exception:                                          # noqa: BLE001
        return None


# ---------- 等待页面稳定 ----------
LOADING = re.compile(r"加载|请稍候|Loading|刷新中")


def watch(prev_sig, timeout=1500):
    """轮询到"变了且停住"。页面在转圈就自动多等一会儿，别让模型白跑一趟。
    返回 (items, sig, pkg, 用时ms, changed)。"""
    t0 = time.time()
    last = None
    while True:
        nodes = raw_nodes()
        items = build(nodes)
        s = sig(items)
        spinning = any(LOADING.search(l) for l, _ in items)
        if s != prev_sig and s == last and not spinning:
            return items, s, info().get("packageName", "?"), int((time.time() - t0) * 1000), True
        last = s
        if (time.time() - t0) * 1000 >= (timeout * 2.5 if spinning else timeout):
            return items, s, info().get("packageName", "?"), int((time.time() - t0) * 1000), s != prev_sig
        time.sleep(0.12)


