def _label_of(pkg):
    """包名 → 桌面显示名。优先含中文的那个键（"哔哩哔哩" 比 "bilibili" 更像图标标签）。"""
    cand = [k for k, v in APPS.items() if v == pkg]
    for k in cand:
        if re.search(r"[\u4e00-\u9fa5]", k):
            return k
    return cand[0] if cand else None


def _open_by_icon(label, max_pages=6):
    """从桌面点图标拉起。当前页没有就往后翻，找完回到起始页。
    返回 (是否点到, 观测到的事实)。事实只写"看了几页、看到几个图标、有没有匹配"，
    不写"可能被隐藏/没装"这种推断。"""
    if not label:
        return False, "没有可用的显示名"
    if info().get("packageName") != dev()["launcher"]:
        a11y("input", "key", "home")
        time.sleep(0.5)
    d = dev()
    cur, total = _page_of(raw_nodes())
    total = min(total or 1, max_pages)
    if cur and cur != 1:                       # 桌面会记住上次停的页，先回第 1 页再扫，否则扫不到前面页的图标
        _goto_page(d, 1, total or 1)
    start = cur or 1
    seen, pages = 0, 0
    if total > 1:
        _warm_desktop()                        # HyperOS 平时不暴露图标，不预热就扫不到
    try:
        for i in range(total):
            pages += 1
            for n in raw_nodes():
                if n.get("clickable"):
                    seen += 1
                    if lbl(n) == label:
                        tap_node(n)
                        return True, f"第 {cur or pages} 页命中"
            if i == total - 1:
                break
            _swipe_page(d, +1)
            nxt, _t = _wait_page(cur)
            if nxt is None or nxt == cur:
                break
            cur = nxt
    finally:
        for _ in range(total + 1):        # 尽量还原到原来的页
            c, _t = _page_of(raw_nodes())
            if c is None or c <= start:
                break
            _swipe_page(d, -1)
            _wait_page(c)
    return False, f"扫了 {pages} 页 / {seen} 个可点节点，没有名为“{label}”的"


def _open_by_recents(label):
