def require_service():
    """开跑前先确认无障碍在跑。掉线时每条命令都要白试十几秒才报错，
    而且失败原因会被误读成"App 没装/图标找不到"——这里一次性说清楚。"""
    try:
        p = subprocess.run(["android-a11y-cli", "service", "ping"],
                           capture_output=True, text=True, timeout=8)
        out = ((p.stdout or "") + (p.stderr or "")).strip()
    except Exception as e:                                     # noqa: BLE001
        out = f"{type(e).__name__}: {e}"
    if "running" not in out.lower():
        print(f"✘ 无障碍服务不在运行：{out[:140]}")
        print("  去 设置→无障碍→Minis 打开（用户自己操作手机时会关掉它，这属于预期）")
        sys.exit(69)


def main():
    ap = argparse.ArgumentParser(prog="scr", add_help=True)
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("look"); p.add_argument("--shot", action="store_true")
    p.set_defaults(f=cmd_look)

    p = sub.add_parser("tap")
    p.add_argument("target"); p.add_argument("--nth", type=int, default=None)
    p.add_argument("--expect", default=""); p.add_argument("--timeout", type=int, default=1500)
    p.add_argument("--max-age", type=int, default=180, help="sN 引用的有效期秒数，默认 180（屏一变即作废）")
    p.set_defaults(f=cmd_tap)

    p = sub.add_parser("xy")
    p.add_argument("x"); p.add_argument("y")
    p.add_argument("--scale", type=float, default=1)
    p.add_argument("--verify", action="store_true"); p.add_argument("--timeout", type=int, default=1500)
    p.set_defaults(f=cmd_xy)

    p = sub.add_parser("type")
    p.add_argument("text"); p.add_argument("--into", default=None)
    p.set_defaults(f=cmd_type)

    p = sub.add_parser("key")
    p.add_argument("name"); p.add_argument("--timeout", type=int, default=1500)
    p.set_defaults(f=cmd_key)

    p = sub.add_parser("swipe")
    p.add_argument("dir", choices=["up", "down", "left", "right"])
    p.add_argument("--dist", type=int, default=800)
    p.set_defaults(f=cmd_swipe)

    p = sub.add_parser("open"); p.add_argument("target"); p.set_defaults(f=cmd_open)

    p = sub.add_parser("wait")
    p.add_argument("target"); p.add_argument("--timeout", type=int, default=4000)
    p.add_argument("--gone", action="store_true"); p.set_defaults(f=cmd_wait)

    p = sub.add_parser("state"); p.set_defaults(f=cmd_state)
    p = sub.add_parser("shot"); p.add_argument("--full", action="store_true"); p.set_defaults(f=cmd_shot)

    p = sub.add_parser("grid")
    p.add_argument("--json", default=None, help="把整份布局写到这个文件")
    p.add_argument("--pages", type=int, default=None, help="读第 1..N 页（盘点用）；不给则只读当前页")
    p.add_argument("--all", action="store_true", help="读全部页")
    p.set_defaults(f=cmd_grid)

    p = sub.add_parser("drag-into", help="拖进文件夹/格子（落点按抬起后布局补偿）")
    p.add_argument("src", help="被拖图标的名字")
    p.add_argument("dst", help="目标格子，如 r3c1")
    p.add_argument("--shift", action="store_true", help="启用回填补偿（默认关闭，实测不需要）")
    p.add_argument("--rollback", action="store_true", help="失败且目标被挤走时，自动把图标拖回原格")
    p.add_argument("--grab-dx", type=int, default=0, help="落点 x 修正（图标中心 vs 指尖）")
    p.add_argument("--grab-dy", type=int, default=0, help="落点 y 修正")
    p.add_argument("--hold", type=int, default=1500)
    p.add_argument("--pick", type=int, default=480)
    p.add_argument("--speed", type=int, default=300, help="移动速度，默认 300（500 易被判甩动→插入）")
    p.set_defaults(f=cmd_drag_into)

    p = sub.add_parser("drag")
    p.add_argument("x1"); p.add_argument("y1"); p.add_argument("x2"); p.add_argument("y2")
    p.add_argument("--hold", type=int, default=2500, help="落点悬停毫秒：页内合并建议 2000–2500；跨页把它当边缘悬停用（1.5s≈翻1页、1.6s≈翻2页）")
    p.add_argument("--pick", type=int, default=480, help='拿起时长毫秒数，默认 480：实测长按阈值 450–500ms，压到 420 常常没拿起、整段位移被当成桌面下滑；>550 才弹应用菜单')
    p.add_argument("--speed", type=int, default=300, help="移动速度 px/s，默认 300（500 判甩动→插入）")
    p.add_argument("--scale", type=float, default=1, help="给的是截图坐标就写 2")
    p.add_argument("--ms", type=int, default=800, help="移动段时长（按住段用 --pick、落点段用 --hold）")
    p.add_argument("--edge", choices=["l", "r"], help="仅 --backend a11y：先拖到左/右边缘等翻页再走落点；r=下一页，l=上一页")
    p.add_argument("--edge-ms", type=int, default=1500, help="仅 --backend a11y：边缘停留毫秒，默认 1500（约一页）")
    p.add_argument("--backend", choices=["drag", "auto", "a11y"], default="drag", help="drag=原生(默认)；a11y=强制抖动兜底")
    p.add_argument("--force", action="store_true", help="允许从顶部死区起手（长按抢得过系统手势时）")
    p.add_argument("--on-desktop", dest="on_desktop", action="store_true",
                   help="先断言前台是桌面，否则拒绝执行（防止手势打到别的 App 上）")
    p.set_defaults(f=cmd_drag)

    p = sub.add_parser("doctor")
    p.add_argument("--save", action="store_true"); p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_doctor)

    p = sub.add_parser("do"); p.add_argument("steps", nargs="+"); p.set_defaults(f=cmd_do)

    a = ap.parse_args()

    # 解析完再预检：--help 不该被无障碍状态挡住；doctor 的职责恰恰是诊断掉线，不能先拦。
    if getattr(a, "cmd", None) and a.cmd != "doctor":
        require_service()
    if not getattr(a, "f", None):
        ap.print_help()
        return
    a.f(a)


if __name__ == "__main__":
    main()
