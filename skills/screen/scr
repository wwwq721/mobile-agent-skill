            if now == pkg:
                return True, now
            if now and now != pkg0 and now != launcher and not now.endswith(".launcher"):
                return True, now
            time.sleep(0.12)
        return False, info().get("packageName", "")

    tried, obs = [], []
    # ① intent：这台机上 android-open 不认 intent: URI（返回 no_handler），
    #    但别的 Android 上可用，所以留着，只是必须校验它真的返回成功。
    comp = COMP.get(pkg)
    uri = ("intent:#Intent;action=android.intent.action.MAIN;category=android.intent.category.LAUNCHER;"
           + (f"component={comp};end" if comp else f"package={pkg};end"))
    try:
        r = subprocess.run(["android-open", uri], capture_output=True, text=True, timeout=10)
        out = (r.stdout or "") + (r.stderr or "")
        open_ok = r.returncode == 0 and '"error"' not in out.lower()
    except subprocess.TimeoutExpired:
        out, open_ok = "android-open 超时（10s）", False
    tried.append("intent")
    ok1, now1 = front_is_target(2.0) if open_ok else (False, "")
    if ok1:
        items, s, now, _ = snap()
        print(f"✔ open {pkg} via intent · {int((time.time()-t0)*1000)}ms" + _via_note(now, pkg))
        emit(items, now)
        return
    # ② 桌面图标 / ③ 最近任务
    # 顺序按"便宜且常见"排：当前页图标/文件夹（本地、最快）→ 最近任务 → 全页扫描。
    # 文件夹必须在全页扫描之前：桌面上的图标本来就大量收在文件夹里，先扫全页会白等 10s。
    for name, fn in (("当前页图标", lambda: _open_by_icon(label, max_pages=1)),
                     ("当前页文件夹", lambda: _open_in_folders(label)),
                     ("最近任务", lambda: _open_by_recents(label)),
                     ("桌面图标", lambda: _open_by_icon(label))):
        tried.append(name)
        hit, note = fn()
        obs.append(f"{name}：{note}")
        ok2, now2 = front_is_target(2.2) if hit else (False, "")
        if ok2:
            items, s, now, _ = snap()
            print(f"✔ open {pkg} via {name}（{label}）· {int((time.time()-t0)*1000)}ms" + _via_note(now, pkg))
            emit(items, now)
            return

    items, s, now, _ = snap()
    ms = int((time.time() - t0) * 1000)
    print(f"✘ open {pkg} 失败 · {ms}ms · 前台仍是 {now}")
    print(f"   找的名字：「{label or '（包名解析不到显示名）'}」；各路由看到的事实：")
    for o in obs:
        print(f"   · {o}")
    emit(items, now)
    sys.exit(1)

def cmd_wait(a):
    t0 = time.time()
    try:
        pat = re.compile(a.target)
    except re.error:                 # 输入里带 ( [ * 等：按字面找，别把用户输入当正则崩掉
        pat = None
        print(f"… “{a.target}” 不是合法正则，按字面匹配")
    while (time.time() - t0) * 1000 < a.timeout:
        items, s, pkg, _ = snap()
        hit = any((pat.search(it[0]) if pat else a.target in it[0]) for it in items)
        if hit != a.gone:
            print(f"✔ {'出现' if hit else '消失'} “{a.target}” · {int((time.time()-t0)*1000)}ms · app {pkg}")
            emit(items, pkg, _LAST["nodes"])       # 等到了就把这一屏贴回来，别让调用方再补一次 look
            return
        time.sleep(0.15)
    items, s, pkg, _ = snap()
    print(f"✘ 超时 {a.timeout}ms，“{a.target}” 未{'消失' if a.gone else '出现'} · app {pkg}")
    emit(items, pkg)
    sys.exit(1)


def cmd_state(a):
    items, s, pkg, _ = snap()
    remember_look(s)
    print(f"app {pkg} · {len(items)} 项 · sig {s}")


def cmd_shot(a):
    path, err = shot(keep_full=a.full)
    if LEFTOVER[0]:
        print(f"⚠ 相册里可能残留 {LEFTOVER[0]}，删不掉，收尾时提醒用户手动删")
    if not path:
        print(f"✘ 截图失败 {err}")
        sys.exit(1)
    print(f"shot {path}")
    print(f"url  minis://workspace/shots/{os.path.basename(path)}")


# ---------- 桌面布局：读 / 搬 ----------
EDIT_CHROME = {"完成", "壁纸", "壁纸效果", "小部件", "桌面设置"}
PAGE_RE = re.compile(r"第\s*(\d+)\s*页共\s*(\d+)\s*页")
BUBBLE = ("点按相应功能", "Minis 无障碍")


def _page_of(nodes):
    for n in nodes:
        m = PAGE_RE.search(lbl(n))
        if m:
            return int(m.group(1)), int(m.group(2))
    return None, None


def _edit_mode(on=True):
    """进/退桌面编辑模式，返回是否处于该模式。

    为什么要进编辑模式：普通桌面下 HyperOS 一个图标节点都不暴露（只有状态栏），
    长按空白进"编辑"后，34 个图标全变成带坐标的可读节点——这是精确读布局的唯一入口。
    """
    W, H = screen_size()
    for n in raw_nodes():
        if lbl(n) == "完成":
            if on:
                return True
            a11y("tap", "node", n["nodeId"])
            time.sleep(0.7)
            return False
    if not on:
        return True
    # 空白点长按：0.78H 一带（最后一行与页码点之间）通常没图标，备用两档
    for fy in (0.78, 0.86, 0.70):
        for fx in (0.5, 0.12, 0.88):
            a11y("tap", "xy", str(int(W * fx)), str(int(H * fy)), "--long")
            time.sleep(1.0)
            if any(lbl(n) == "完成" for n in raw_nodes()):
                return True
    return False


def _icons_now():
    """编辑模式下的图标清单 [(name, x, y)]，按网格容差过滤掉工具条/气泡。"""
    d = dev()
    nodes = raw_nodes()
    W, H = screen_size()
    gx, gy = d["grid_x"], d["grid_y"]
    tol_x, tol_y = 90, 110      # 半个格子内：再大就可能是工具条/Dock
    out = []
    for n in nodes:
        t = lbl(n)
        if not n["clickable"] or t in EDIT_CHROME:
            continue
        if not t:                       # 编辑模式下没文字却占一格 = 文件夹，不能算空位
            cx0, cy0 = n["center"]["x"], n["center"]["y"]
            if (min(abs(cx0 - x) for x in gx) <= tol_x
                    and min(abs(cy0 - y) for y in gy) <= tol_y):
                out.append(("(文件夹)", cx0, cy0))
            continue
        if any(b in t for b in BUBBLE) or PAGE_RE.search(t):
            continue
        cx, cy = n["center"]["x"], n["center"]["y"]
        if min(abs(cx - x) for x in gx) > tol_x or min(abs(cy - y) for y in gy) > tol_y:
            continue
        out.append((t, cx, cy))
    return out


def _cell(x, y):
    d = dev()
    col = min(range(len(d["grid_x"])), key=lambda i: abs(x - d["grid_x"][i])) + 1
    row = min(range(len(d["grid_y"])), key=lambda i: abs(y - d["grid_y"][i])) + 1
    return row, col


def _swipe_page(d, step):
    """step=+1 下一屏，-1 上一屏。走 0.46H，避开顶部死区和底部 Dock。"""
    W, H = screen_size()
    y = int(H * 0.46)
    x1, x2 = (int(W * 0.8), int(W * 0.25)) if step > 0 else (int(W * 0.25), int(W * 0.8))
    a11y("gesture", "swipe", str(x1), str(y), str(x2), str(y), "300")


def _wait_page(prev, timeout=2.5):
    """翻页后等页码真的变（编辑模式里"第 N 页共 M 页"是权威信号）。
    不等就拍是这次踩的坑：连拍三张同一页，然后一下跳过一整页。"""
    t0 = time.time()
    while time.time() - t0 < timeout:
        cur, total = _page_of(raw_nodes())
        if cur is not None and cur != prev:
            time.sleep(0.15)
            return cur, total
        time.sleep(0.08)
    cur, total = _page_of(raw_nodes())
    return cur, total


def _icons_normal():
    """普通桌面下的图标清单 [(name, x, y)]，外加小部件。

    坐标口径与 look/xy 一致（节点中心）。为什么不用编辑模式：编辑模式是缩略布局，
    豌豆荚 502,560 / 计算器 227,1156，普通桌面是 489,407 / 188,1059，差 40–150px，
    按编辑模式的坐标点会落到邻格。
    过滤用区域而不是"离格子中心多近"：后者会把 2×2 小部件（系统工具中心 940,1560，
    离最近的格子中心 150px）当噪声丢掉。
    """
    d = dev()
    gx, gy = d["grid_x"], d["grid_y"]
    out, widgets, seen = [], [], set()
    for n in raw_nodes():
        t = lbl(n)
        if t and (PAGE_RE.search(t) or t in EDIT_CHROME):
            continue
        if not n.get("clickable") and not t:
            continue
        b = n.get("bounds") or {}
        x, y = n["center"]["x"], n["center"]["y"]
        if not (150 <= x <= 1150 and 280 <= y <= 2185):
            continue                          # 状态栏 / 页码点 / Dock
        area = (b.get("right", 0) - b.get("left", 0)) * (b.get("bottom", 0) - b.get("top", 0))
        W, H = _scrn()
        if area > 0.45 * W * H:
            continue                          # 整屏容器（壁纸/根布局），不是小部件
        if area > 180000:                     # 一格约 301×326=98k，两格以上算小部件
            if not t and widgets:
                continue                      # 无名的嵌套容器：跟着小部件一起出现，跳过
            if (t, x, y) not in seen:
                seen.add((t, x, y))
                widgets.append((t or "(小部件)", x, y))
            continue
        t = t or "(文件夹)"                   # 普通桌面上文件夹节点没有文字
        if (t, x, y) in seen:
            continue
        seen.add((t, x, y))
        out.append((t, x, y))
    return out, widgets


def _goto_page(d, target, total):
    """按页码节点翻到 target 页（撞边不动，多滑几次是安全的）。"""
    for _ in range(total + 2):
        c, _t = _page_of(raw_nodes())
        if c is None or c == target:
            return c
        _swipe_page(d, -1 if c > target else +1)
        _wait_page(c)
    return None


def _warm_desktop():
    """让普通桌面把图标暴露进无障碍树（读布局前的"预热"）。

    HyperOS 桌面平时只暴露 Dock 和页码，页面上的图标一个都不给（实测：28 个节点，
    可点的只有夸克/电话/微信/QQ）。进出一次编辑模式之后，图标会在普通桌面上暴露
    一段时间，且坐标是**普通桌面那一套**——编辑模式里图标是缩略布局，豌豆荚 502,560、
    计算器 227,1156，而普通桌面是 489,407 / 188,1059，差 40–150px，按编辑模式的坐标
    去点正好落到邻格（我据此点开过 ToDesk）。
    """
    if _icons_normal()[0]:
        return True
    d = dev()
    W, H = _scrn()
    for fy in (0.78, 0.86, 0.70):
        for fx in (0.5, 0.12, 0.88):
            a11y("tap", "xy", str(int(W * fx)), str(int(H * fy)), "--long")
            time.sleep(0.9)
            done = [n for n in raw_nodes() if lbl(n) == "完成"]
            if not done:
                continue
            a11y("tap", "xy", str(done[0]["center"]["x"]), str(done[0]["center"]["y"]))
            time.sleep(0.9)
            return bool(_icons_normal()[0])
    return False


def cmd_grid(a):
    """把桌面读成一张表：页-行-列 / 名称 / 坐标。只读，不动布局、不进编辑模式。"""
    d = dev()
    W, H = _scrn()
    pkg = info().get("packageName", "")
    if pkg != d["launcher"]:
        print(f"✘ 前台是 {pkg}，不是桌面（{d['launcher']}）：先 scr key home 再试")
        sys.exit(1)
    if not _warm_desktop():
        print("✘ 桌面图标不可读（进出编辑模式也没让它们进无障碍树）：改用 scr look 或 scr shot 看图")
        sys.exit(2)
    cur, total = _page_of(raw_nodes())
    start_page = cur or 1
    total = total or a.pages or 5
    if a.all or a.pages:                      # 盘点才翻页；默认只读当前页（快、且不扰动布局）
        last = total if a.all else min(a.pages or total, total)
        _goto_page(d, 1, total)
        cur_page, end_page = 1, last
    else:
        cur_page, end_page = start_page, start_page
    pages = []
    while True:
        icons, wids = _icons_normal()
        p, _t = _page_of(raw_nodes())
        p = p or len(pages) + 1
        if not pages and not icons:
            print(f"✘ 桌面图标没进无障碍树（只拿到 {len(raw_nodes())} 个节点）："
                  "这一屏没暴露内容，等 1s 重试，或直接用 scr shot 看图")
            sys.exit(2)
        pages.append((p, icons, wids))
        if p >= end_page or len(pages) > total + 1:
            break
        _swipe_page(d, +1)
        nxt, _t = _wait_page(p)
        if nxt is None or nxt == p:
            break
        if not _icons_normal()[0]:        # 翻页会把暴露状态打回原形，重暖一次
            _warm_desktop()
    if a.all or a.pages:
        _goto_page(d, start_page, total)      # 翻过页才需复位；单页模式本来就没动
    lines = []
    for p, icons, wids in pages:
        table = {}
        for name, x, y in icons:
            table[_cell(x, y)] = (name, x, y)
        empty = [f"{r}-{c}" for r in range(1, d["rows"] + 1)
                 for c in range(1, d["cols"] + 1) if (r, c) not in table]
        lines.append(f"页{p} · {len(icons)} 个图标 · 空位 {len(empty)}"
                     + (f" · {', '.join(empty)}" if len(empty) <= 8 else ""))
        for (r, c), (name, x, y) in sorted(table.items()):
            lines.append(f"  {r}-{c}  {name:<20s} {x},{y}")
        for name, x, y in wids:
            lines.append(f"  小部件  {name:<18s} {x},{y}")
    now_page, _t = _page_of(raw_nodes())
    print(f"桌面 {d['cols']}×{d['rows']} · {W}×{H} · 共 {total} 页"
          f" · 当前停在第 {now_page or start_page} 页")
    print("\n".join(lines))
    if a.json:
        json.dump([{"page": p,
                    "icons": [{"name": n, "x": x, "y": y,
                               "row": _cell(x, y)[0], "col": _cell(x, y)[1]}
                              for n, x, y in ic],
                    "widgets": [{"name": n, "x": x, "y": y} for n, x, y in wd]}
                   for p, ic, wd in pages],
                  open(a.json, "w"), ensure_ascii=False, indent=1)
        print(f"json {a.json}")

def _dump_sig():
    """当前屏的指纹：有节点就用节点，桌面一律返回 None（节点只有状态栏/气泡，比不出图标变化）。"""
    if info().get("packageName") == dev()["launcher"]:
        return None
    try:
        nodes = raw_nodes()
    except SystemExit:
        return None
    items = build(nodes)
    return sig(items) if len(items) >= 3 else None


def _gesture_drag(x1, y1, x2, y2, hold_ms=800, dur_ms=900, end_hold_ms=600):
    """原生拖拽（1.16-beta.8+）：一根手指按下→按住→移动→落点按住→抬起。

    返回 (ok, 说明)。旧版本没有这个子命令，会回 {"error": ...} 或非 0，调用方据此退回抖动法。
    """
    r = a11y("gesture", "drag", str(x1), str(y1), str(x2), str(y2),
             "--hold-ms", str(hold_ms), "--duration", str(dur_ms), "--end-hold-ms", str(end_hold_ms))
    ok = bool(r.get("ok"))
    d = r.get("data") or {}
    return ok, f"holdMs={d.get('holdMs')} totalMs={d.get('totalMs')}"

def _drag_a11y_jitter(x1, y1, x2, y2, hold_ms=2500, pick_ms=480, speed=300,
                      edge=None, edge_ms=700):
    """抖动法拖拽：一个连续过程，按下→按住→移动→落下，中间不抬手。

    `gesture path` 的 `--duration` 是**按路径几何长度均分**给每个点的，不是按点数。
    这条事实决定了所有参数怎么算：

      ①拿起 pick_ms（默认 480）：±3px 方波。实测长按阈值 450–500ms，
         <450ms 图标没拿起、整段位移被桌面当成下滑（弹搜索）或翻页；
         >550ms 才开始动会先弹应用菜单。
      ②移动 按 speed 走（默认 300px/s ≈ 12.6px/点）。太快会被判甩动，落点变"插入"。
      ③落点悬停 hold_ms：原地抖动。停死等于松手，必须一直微动。
      ④抬手前继续微动，落点才不飘。

    edge="l"/"r"：跨页路径——拿起 → 拖到屏幕左/右边缘停 edge_ms 等翻页 → 再走到落点。
    跨页只能一次注入做完（a11y 没有"按住不放跨越两次调用"的能力）。
    """
    MSPP = 42
    box = 3        # ±3px：留在触摸阈值内

    def shiver(x, y, n):
        return [(x + (box if i % 2 else -box), y + (box if (i // 2) % 2 else -box))
                for i in range(n)]

    W, _H = screen_size()
    dist = ((x2 - x1) ** 2 + (y2 - y1) ** 2) ** 0.5
    step = max(8, speed * MSPP / 1000.0)
    n_settle = 6
    BUDGET = 5200      # 实测系统在 5.9–6.2s 取消整条 path
    n_hold = max(4, int(hold_ms / MSPP))

    if edge:
        fast = step * 6                      # 跨页段长，不提速会顶到取消阈值
        # 别贴到 18px：两侧是返回手势区，指尖在里面拖会被当成"返回"。70px 在图标列之外。
        ex = 70 if edge == "l" else W - 70
        sx = x1 + (120 if ex > x1 else -120)
        n_seg1 = max(2, int(abs(sx - x1) / step))
        n_seg2 = max(2, int(abs(ex - sx) / fast))
        n_edge = max(4, int(edge_ms / MSPP))
        n_move = max(2, int(abs(x2 - ex) / fast))
        n_other = n_seg1 + n_seg2 + n_edge + n_move + n_hold + n_settle
        lo = abs(sx - x1) + abs(ex - sx) + abs(x2 - ex) + 3 * (n_edge + n_hold + n_settle)
    else:
        n_move = max(2, int(dist / step))
        n_other = n_move + n_hold + n_settle
        lo = dist + 3 * (n_hold + n_settle)

    # 核心修正：pick 段的点数必须按"整条路径长度"反算。
    # 固定 11 点抖动在页内只值约 430ms（勉强够），跨页长路径下只值约 90ms——
    # 于是整段被当成滑动，图标没拿起、桌面却翻了一页。二分求点数，让这一段刚好值 pick_ms。
    def pick_span(k):
        lp = k * 2 * box
        return lp / (lp + lo) * (k + n_other) * MSPP

    lo_k, hi_k = 2, 400
    while lo_k < hi_k:
        mid = (lo_k + hi_k) // 2
        if pick_span(mid) < pick_ms:
            lo_k = mid + 1
        else:
            hi_k = mid
    n_pick = lo_k

    total = (n_pick + n_other) * MSPP
    if total > BUDGET:                       # 超预算先砍悬停，给落点留 6 点微动
        cut = min(n_hold - 6, (total - BUDGET) // MSPP)
        if cut > 0:
            n_hold -= cut
            n_other -= cut
            total = (n_pick + n_other) * MSPP

    pts = shiver(x1, y1, n_pick)
    if edge:
        pts += [(round(x1 + (sx - x1) * i / n_seg1), y1) for i in range(1, n_seg1 + 1)]
        pts += [(round(sx + (ex - sx) * i / n_seg2), y1) for i in range(1, n_seg2 + 1)]
        # 贴边"推"：原地 ±3px 会被当成手指停住，翻页不触发；在内侧 12px 来回推进才认。
        pts += [(ex - (12 if k % 2 else 0), y1 + (2 if k % 4 < 2 else -2))
                for k in range(n_edge)]
        pts += [(round(ex + (x2 - ex) * i / n_move), round(y1 + (y2 - y1) * i / n_move))
                for i in range(1, n_move + 1)]
    else:
        pts += [(round(x1 + (x2 - x1) * i / n_move), round(y1 + (y2 - y1) * i / n_move))
                for i in range(1, n_move + 1)]
    pts += shiver(x2, y2, n_hold)
    pts += shiver(x2, y2, n_settle)
    path = ":".join(f"{px},{py}" for px, py in pts)
    r = a11y("gesture", "path", path, "--duration", str(total))
    if os.environ.get("SCR_DRAG_DEBUG"):
        print(f"  [drag] pick={n_pick}点≈{pick_span(n_pick):.0f}ms move={n_move} "
              f"hold={n_hold} edge={n_edge if edge else 0} total={total}ms", file=sys.stderr)
    return bool(r.get("ok"))

def _order_cells(icons):
    """当前页按阅读顺序（行优先）排好的格子 [(name, row, col, x, y)]。"""
    d = dev()
    out = []
    for name, x, y in icons:
        r, c = _cell(x, y)
        out.append((name, r, c, d["grid_x"][c - 1], d["grid_y"][r - 1]))
    out.sort(key=lambda t: (t[1], t[2]))
    return out

def cmd_drag_into(a):
    """把图标拖到指定格子（文件夹就按格子指，它没有名字）。

    **落点默认按"拖之前"的格子中心，不做回填补偿**（--shift 才补偿）。
    2026-11-26 实测：拖到文件夹原位时，有时合并、有时被挤成插入，说明"补偿/不补偿"
    两种简单规则都不足以解释 launcher 的行为；先按格心落，再读结果判断，别预先补偿。

    落点用格子中心（=图标中心）。指尖与图标中心的偏差用 --grab-dx/--grab-dy 修。

    用法：scr drag-into "某个 App" r6c1 [--grab-dx 0 --grab-dy -20]
    """
    import re as _re
    if not _warm_desktop():
        print("✘ 桌面图标没进无障碍树（预热失败），无法安全读数：先 scr doctor")
        sys.exit(2)
    icons = _icons_normal()[0]
    if not icons:
        print("✘ 当前桌面读不到图标：先 scr doctor")
        sys.exit(2)
    cells = _order_cells(icons)
    hits = [c for c in cells if c[0] == a.src] or [c for c in cells if a.src in c[0]]
    if not hits:
        print(f"✘ 当前页 {len(cells)} 个图标里没有 “{a.src}”：{', '.join(c[0] for c in cells)}")
        sys.exit(1)
    if len(hits) > 1:
        print(f"✘ “{a.src}” 命中 {len(hits)} 个（{'、'.join(f'r{c[1]}c{c[2]}' for c in hits)}）：说全名")
        sys.exit(1)
    src = hits[0]
    cells_src_name = src[0]
    m = _re.fullmatch(r"[rR](\d)[cC](\d)", a.dst)
    if not m:
        print("✘ 目标要给格子，如 r3c1（文件夹在无障碍里没有文字，只能按格子指）")
        sys.exit(2)
    tr, tc = int(m.group(1)), int(m.group(2))
    d = dev()
    if not (1 <= tr <= len(d["grid_y"]) and 1 <= tc <= len(d["grid_x"])):
        print(f"✘ 格子 {a.dst} 越界：本机 {len(d['grid_y'])} 行 × {len(d['grid_x'])} 列")
        sys.exit(2)
    # 抬起后回填：位于起点之后的项整体前移一位 → 目标的实际落点是"它前一位"的格子
    idx_src = next(i for i, c in enumerate(cells) if c is src)
    idx_dst = next((i for i, c in enumerate(cells) if c[1] == tr and c[2] == tc), None)
    if not a.shift or idx_dst is None:
        print(f"… 直接落 r{tr}c{tc}（对准格子中心；实测目标在落下前不会先移动）")
    elif idx_dst > idx_src:
        real = cells[idx_dst - 1]
        print(f"… 抬起后回填：{a.dst} 会前移到 r{real[1]}c{real[2]}，按那里落")
        tr, tc = real[1], real[2]
    elif idx_dst is not None and idx_dst < idx_src:
        real = cells[idx_dst + 1]
        print(f"… 起点在目标之后：{a.dst} 不动，落点取 r{real[1]}c{real[2]}（后一位）")
        tr, tc = real[1], real[2]
    cols_n = len(d["grid_x"])

    def _idx(r, c):
        return (r - 1) * cols_n + (c - 1)

    def _drop(ax, ay, bx, by):
        ok, _det = _gesture_drag(ax, ay, bx, by, hold_ms=a.pick, dur_ms=900, end_hold_ms=a.hold)
        if not ok:
            print("… 原生 gesture drag 不可用，退回抖动兜底")
            ok = _drag_a11y_jitter(ax, ay, bx, by, a.hold, a.pick, a.speed)
        time.sleep(1.0)
        return ok

    def _reread():
        best = []
        for _ in range(3):
            _warm_desktop()
            cur = _icons_normal()[0]
            if len(cur) > len(best):
                best = cur
            time.sleep(0.4)
        return _order_cells(best)

    def _anchor(r, c):
        return (d["grid_x"][c - 1] + a.grab_dx, d["grid_y"][r - 1] + a.grab_dy)

    cur_page = _page_of(raw_nodes())[0]
    j = _idx(tr, tc)
    occupied = {_idx(c[1], c[2]) for c in cells}

    # 规范化：源在目标之前时，"插入位"会抢在合并前——先把图标搬到目标之后的空格，再按"源在后"落
    if _idx(src[1], src[2]) < j:
        holes = [k for k in sorted(occupied.symmetric_difference(range(_idx(1, 1), _idx(d["rows"], cols_n) + 1)))
                 if k > j]
        if holes:
            hr, hc = divmod(holes[0], cols_n)
            hr, hc = hr + 1, hc + 1
            print(f"… 源在目标之前：先落到 r{hr}c{hc}（目标之后的空格），再合进去")
            _drop(src[3], src[4], *_anchor(hr, hc))
            cells = _reread()
            src = next((c for c in cells if c[0] == cells_src_name), None) or \
                  next((c for c in cells if c[0] == src[0]), None)
            if not src:
                print("✘ 规范化这一步后找不到被拖图标：先 scr grid 看现状，别重跑")
                sys.exit(1)
        else:
            print("… 目标之后没有空格：直接落（可能变成插入，落完会核）")

    pre = len(cells)
    x2, y2 = _anchor(tr, tc)
    print(f"… 拖 “{src[0]}” r{src[1]}c{src[2]} → 落点 r{tr}c{tc} ({x2},{y2}) · 第 {cur_page or '?'} 页")
    ok = _drop(src[3], src[4], x2, y2)
    post = _reread()
    still = [c for c in post if c[0] == src[0]]
    folder_there = any(c[0] == "(文件夹)" and (c[1], c[2]) == (tr, tc) for c in post)
    inside = None
    if not still and folder_there:                # 图标离桌且目标格仍是文件夹 → 开进去核对
        a11y("tap", "xy", str(x2), str(y2))
        time.sleep(1.3)
        inside = '"found":true' in a11y("scroll", "to-text", src[0])
        a11y("input", "key", "back")
        time.sleep(0.9)
    if inside:
        print(f"✔ 已并入 r{tr}c{tc}：“{src[0]}”在文件夹内可见，页面 {pre} → {len(post)} 项")
        return
    where = (f"r{still[0][1]}c{still[0][2]}" if still else "已不在桌面")
    print(f"✘ 没并进去：“{src[0]}” {where}；页面 {pre} → {len(post)} 项；"
          f"目标格{'仍是文件夹' if folder_there else '已不是文件夹（被挤走=插入）'}")
    if not folder_there and a.rollback:
        back = next((c for c in cells if c[0] == src[0]), None)
        if back:
            print(f"… 回滚：把 “{src[0]}” 从 {where} 拖回原格 r{back[1]}c{back[2]}")
            _drop(still[0][3], still[0][4], *_anchor(back[1], back[2])) if still else None
    print("  下一次先 scr grid 看实际情况再决定，别直接重跑")
    sys.exit(1)

def cmd_drag(a):
    """把 (x1,y1) 的图标长按拖到 (x2,y2)，拖完给结论。

    默认走原生 `gesture drag`（1.16-beta.8+，一根手指按下→按住→移动→落点按住→抬起）；
    老版本没有该子命令时才退回抖动法（--backend a11y 可强制走它）。
    """
    if a.on_desktop:
        pkg0 = info().get("packageName", "")
        if pkg0 != dev()["launcher"]:
            print(f"✘ 前台是 {pkg0}，不是桌面（{dev()['launcher']}）：手势会打到 App 上，"
                  "先把手机停在桌面/别在操作时用手机")
            sys.exit(3)
    W, H = screen_size()
    x1, y1, x2, y2 = int(a.x1), int(a.y1), int(a.x2), int(a.y2)
    if a.scale and a.scale != 1:                 # 允许直接给截图坐标
        x1, y1, x2, y2 = [int(v * a.scale) for v in (x1, y1, x2, y2)]
    if y1 < H * TOP_DEAD and y2 > y1 and not a.force:
        print(f"✘ 起点 y={y1} 在顶部死区（<{int(H*TOP_DEAD)}）：下滑会被下拉通知/搜索吃掉，"
              "换一行图标，或先把页面往上滑")
        sys.exit(3)
    pre_page = _page_of(raw_nodes())[0]        # 桌面才有页码，用来识别"没拿起变成翻页"
    pre_sig = _dump_sig()
    pre_shot = None
    if pre_sig is None:
        pre_shot, _e = shot()
    used, ok, detail = None, False, ""
    if a.backend != "a11y":
        ok, gdetail = _gesture_drag(x1, y1, x2, y2, hold_ms=a.pick, dur_ms=max(200, a.ms),
                                    end_hold_ms=a.hold)
        if ok:
            used, detail = "a11y-drag", gdetail
        elif a.backend == "drag":
            print("✘ 本机 android-a11y-cli 不支持 gesture drag（需 1.16-beta.8+）："
                  "升级 app，或用 --backend a11y 走抖动兜底")
            sys.exit(2)
        else:
            print("… 原生 gesture drag 不可用，退回抖动兜底")
    if not ok:
        ok = _drag_a11y_jitter(x1, y1, x2, y2, a.hold, a.pick, a.speed, a.edge, a.edge_ms)
        used, detail = "a11y-jitter", ""
    time.sleep(0.8)
    if pre_sig is not None:                      # 有节点：按结构比，最硬
        post = _dump_sig()
        changed = post is not None and post != pre_sig
        basis = "节点结构"
    else:                                        # 桌面没图标节点，只能看像素
        post_shot, _e = shot()
        d = diff(post_shot, pre_shot) if (post_shot and pre_shot) else None
        # 实测（本机 640×1386 小图）：搬动一个图标，整屏差 0.3–1.2%——**小变化才是成功**；
        # 界面被切走（下拉搜索、换页、弹菜单）反而 >15%。旧版用"差 >0.5% 才算动"，
        # 把 0.5% 的真实搬动判成失败，方向正好反了。
        changed = d is not None and d > 0.15
        if d is not None and d > 15:
            print(f"⚠ 像素差 {d}%：整屏都变了，多半没拿起（整段位移被当成下滑/翻页/长按菜单）")
        basis = f"像素差 {d}%" if d is not None else "像素差取不到"
    post_page = _page_of(raw_nodes())[0]
    if a.edge and pre_page and post_page and pre_page == post_page:
        print(f"⚠ 边缘停留没触发翻页（仍停在第 {post_page} 页）：加大 --hold（跨页悬停），"
              "或确认 --edge 方向和目标页的相对位置")
    # 跨页拖拽本来就要翻页，别把"页面变了"当成"没拿起"
    flipped = bool(pre_page and post_page and pre_page != post_page) and not a.edge
    if flipped:                                # 拿起失败时，剩下的位移被桌面当成翻页
        print(f"✘ 没拿起，变成了翻页：桌面 {pre_page} → {post_page} 页（via {used}）")
        print("  下一步：先把桌面翻回去；拖拽见 SKILL.md 的通道限制说明")
        sys.exit(1)
    mark = "✔" if changed else "?"
    print(f"{mark} drag {x1},{y1} → {x2},{y2} via {used} · "
          f"{'位置变了' if changed else '未确认（不代表没动）'} · 依据 {basis}（耗时 {a.ms}ms）")
    if not changed:
        print("  下一步：scr grid 看实际落点；跨页可加大 --hold（边缘悬停时长）")
        sys.exit(1)


def cmd_do(a):
    """按顺序跑一串动作；中间步骤只留一行结论，最后统一给一屏。任一步失败即停。"""
    env = dict(os.environ, SCR_QUIET="1")
    for step in a.steps:
        verb, _, arg = step.partition(":")
        argv = [sys.executable, os.path.abspath(__file__), verb] + ([arg] if arg else [])
        print(f"── {step}")
        r = subprocess.run(argv, capture_output=True, text=True, env=env)
        sys.stdout.write(r.stdout or r.stderr)
        if r.returncode != 0:
            print(f"✘ 停在 “{step}”，下面是现在的屏幕：")
            sys.exit(r.returncode)
        time.sleep(0.1)
    cmd_look(argparse.Namespace(shot=False))


def cmd_doctor(a):
    """换机 / 授权变动后跑这一条：逐项体检，--save 把测到的常数写进 device.json。

    只读：不点屏幕、不进编辑模式；唯一副作用是截一张图验证通道。
    检查项按依赖顺序排，第一项过不了后面就都是空的。
    """
    rep, rows = {}, []
    bad = [0]

    def add(k, v, ok=True, hint=""):
        rep[k] = v
        rows.append((k, v, ok, hint))
        if not ok:
            bad[0] += 1

    def out():
        if a.json:
            print(json.dumps({"ok": bad[0] == 0, "items": rep}, ensure_ascii=False))
            return
        for k, v, ok, hint in rows:
            print(f"{'✅' if ok else '❌'} {k:<12} {v}")
            if hint and not ok:
                print(f"{'':<15}→ {hint}")
        print("✅ 全部通过" if bad[0] == 0 else f"❌ {bad[0]} 项不通过")
        if bad[0]:
            print("下一步：先修上面第一条 ❌，后面的项都依赖它。")

    # 1) 读屏通道——这是所有检查的前提
    d0 = a11y("ui", "dump")
    if not d0.get("ok"):
        e = d0.get("error") or {}
        add("读屏通道", f"✘ {e.get('code')} {str(e.get('message'))[:60]}", False,
            "Settings → Permissions → Integrations：android-a11y-cli 设为 Allow")
        out()
        sys.exit(2)

    nodes = d0["data"]["nodes"]
    info_ = info()
    pkg = info_.get("packageName", "")
    st = a11y("service", "status").get("data") or {}
    add("无障碍服务", f"state={st.get('state')} caps={','.join(st.get('capabilities') or [])}",
        st.get("state") == "ON", "设置→无障碍 里把 Minis 重新打开；HyperOS 会自己把它关掉")

    model = {}
    try:
        model = json.loads(subprocess.run(["android-device", "info"], capture_output=True,
                                          text=True).stdout)
    except Exception:                                          # noqa: BLE001
        pass

    # 2) 屏幕与状态栏/导航条
    H = max([n["bounds"]["bottom"] for n in nodes] + [0])
    W = max([n["bounds"]["right"] for n in nodes] + [0])
    d = dev()
    # 屏幕尺寸以截图元数据为准：前台是悬浮窗/分屏时，"最大节点"只是那个窗口的尺寸。
    sw = sh_ = None
    try:
        meta = a11y("ui", "screenshot", "--format", "jpeg")
        if meta.get("ok"):
            sw, sh_ = meta["data"].get("originalWidth"), meta["data"].get("originalHeight")
    except Exception:                                          # noqa: BLE001
        pass
    W, H = (sw, sh_) if (sw and sh_) else (W, H)
    add("屏幕", f"{W}×{H}" + ("" if (W, H) == (d["w"], d["h"]) else f"（档案里是 {d['w']}×{d['h']}，需更新）"),
        (W, H) == (d["w"], d["h"]), "scr doctor --save 会把实测值写进 device.json")
    add("机型", f"{model.get('manufacturer','?')} {model.get('model','?')} / Android {model.get('android_version','?')}")

    roots = [n for n in nodes if n["depth"] == 0]
    add("窗口根数", f"{len(roots)} 根 · " + ",".join(sorted({(n.get("packageName") or "?") for n in roots})[:4]),
        len(roots) >= 1)
    field = sum(1 for n in nodes if n.get("packageName"))
    add("节点含包名", f"{field}/{len(nodes)}", field > 0,
        "若为 0 说明这版 CLI 不返回 packageName，包名只能靠 ui info")

    # 3) 清单与像素模式判据
    items = build(nodes)
    raw_click = [n for n in nodes if n["clickable"] or n["editable"] or n["checkable"]]
    ids = {n["nodeId"] for _, n in items}
    # 只拿"有标签的可点节点"比：无标签的可点节点（桌面上就是文件夹格子、整屏容器、
    # 状态栏芯片）本来就不该进清单——按全部可点节点算会永远误报，把体检结论带偏。
    W_, H_ = _scrn()
    named = [n for n in raw_click
             if lbl(n) and not PAGE_RE.search(lbl(n))
             and (n["bounds"]["right"] - n["bounds"]["left"]) *
                 (n["bounds"]["bottom"] - n["bounds"]["top"]) < 0.4 * W_ * H_]
    miss = [n for n in named if n["nodeId"] not in ids]
    add("清单/原始", f"清单 {len(items)} 项 · 有标签可点 {len(named)} 个 · 漏掉 {len(miss)}"
        + (f"（含 {len(raw_click) - len(named)} 个无标签可点节点，桌面文件夹/容器属正常）"
           if len(raw_click) > len(named) else ""),
        len(miss) <= max(2, len(named) // 3),
        "漏太多说明 build() 过滤过狠（小图标 <4000px²、超大容器、被外壳吞掉的子控件）")
    add("像素模式", f"当前屏会判定：{'是（会截图）' if len(items) < 3 else '否'}",
        not (len(items) >= 3 and len(raw_click) < 3),
        "清单 <3 但其实有可点节点 = 假像素模式，白花一次截图")

    # 3.5) 手势能力（1.16-beta.8 才有原生 drag；没有就得靠 a11y 兜底）
    g = a11y("gesture", "drag", "1", "1", "2", "2", "--hold-ms", "0", "--duration", "100", "--end-hold-ms", "0")
    add("原生drag", "gesture drag 可用" if g.get("ok") else "不可用（需 1.16-beta.8+，只能 --backend a11y）",
        bool(g.get("ok")), "升级 Minis app；老版本用 scr drag --backend a11y 走抖动兜底")

    # 4) 桌面
    if pkg == d["launcher"]:
        add("桌面节点", f"普通态 {len(items)} 项（HyperOS 通常为 0，靠 grid/截图）", True)

    # 5) 截图通道（系统弹窗/权限框在上面时 takeScreenshot 会失败，隔 0.6s 再试一次再判死）
    t0 = time.time()
    path, err = shot()
    if not path:
        time.sleep(0.6)
        path, err = shot()
    ms = int((time.time() - t0) * 1000)
    if path:
        try:
            from PIL import Image
            vw, vh = Image.open(path).size
        except Exception:                                      # noqa: BLE001
            vw, vh = 0, 0
        # 档案里的 scale 是"看图/屏幕"的比例（0.5=半尺寸），xy 的 --scale 是它的倒数
        ratio = round(vw / W, 3) if W else 0
        add("截图通道", f"{ms}ms · 看图 {vw}×{vh} · 看图/屏幕 = {ratio}"
            + ("" if ratio == d["scale"] else f"（档案是 {d['scale']}，需更新）"), ratio > 0)
    elif err == "SECURE":
        add("截图通道", f"{ms}ms · 当前窗口禁止截屏（受保护窗口，属正常）", True)
    else:
        add("截图通道", f"{ms}ms · ✘ {err}", False, "无障碍 takeScreenshot 不可用时会退回通知栏磁贴")

    if a.save:
        nd = dict(d)
        nd.update({"w": W, "h": H, "launcher": pkg if pkg == d["launcher"] else d["launcher"],
                   "android": str(model.get("android_version", "")),
                   "model": str(model.get("model", "")), "save_at": int(time.time())})
        save_dev(nd)
        add("device.json", DEVFILE, True)
    out()
    if bad[0]:
        sys.exit(1)


