IRREVERSIBLE = re.compile(r"^(提交|支付|下单|购买|确认付款|确认支付|发送|发表|发布|删除|清空|退出|注销|"
                          r"授权|允许|安装|下载|关注|取消关注|取关|解绑|充值|转账|退订)$")

def rank_cands(cand, target, title=""):
    """重名时自己挑一个：完全匹配 > 前缀 > 包含；不是页面标题的优先（标题那条常常是
    搜索框里的回声或 H1，点了等于再搜一次）；再优先可点击；最后按阅读顺序取最上最左。
    网页里点错链接是免费的（bw key back 一句就退回），停下来问反而更贵。"""
    low = any(it[3]["bounds"]["top"] >= 360 for it in cand)

    def key(it):
        t = it[2]
        m = 0 if t == target else (1 if t.startswith(target) else 2)
        echo = 1 if (title and t == title) else 0
        if low and it[3]["bounds"]["top"] < 360:
            echo += 2                      # 页面头部区域（搜索框/导航）里的重名，最后才考虑
        clickable = 0 if it[3].get("clickable") else 1
        b = it[3]["bounds"]
        return (echo, m, clickable, b["top"] // 8, b["left"])
    return sorted(cand, key=key)

def tap_text(target, nth=None, timeout=5000):
    """找到并点中。返回 (nodes, 变化了吗, 用时ms, 点中的标签)。
    找不到就 die；命中多个默认自己挑最像的那个，并在一行里说清挑了谁、还剩谁。"""
    nodes = dump()
    items = page_items(nodes)
    t = target.strip()
    exact = [it for it in items if it[2] == t]
    cand = exact or [it for it in items if t in it[2]]
    if not cand:
        die(f'这一屏没有“{target}”', "先 bw read 看看；或 bw read -n 1 往下翻一屏再找")
    note = ""
    if len(cand) > 1 and nth is None:
        if IRREVERSIBLE.match(t):
            print(f"✘ “{target}” 是敏感动作且命中 {len(cand)} 个，不敢替你挑：")
            for it in cand[:6]:
                print(f"  {it[2][:40]} @{it[3]['bounds']['left']},{it[3]['bounds']['top']}")
            print("  用 --nth N 指定")
            sys.exit(3)
        cand = rank_cands(cand, t, bar_text(nodes))
        others = [it[2][:16] for it in cand[1:4]]
        note = f"（{len(cand)} 个同名，取最上那个；其余：" + " / ".join(others) + "）"
    pick = cand[(nth or 0) % len(cand)]
    nodes, changed, ms = tap_and_wait(pick[3], timeout, before_sig=sig(nodes))
    return nodes, changed, ms, pick[2][:36] + note

def tap_and_wait(node, timeout=5000, before_sig=None):
    """点一下再等页面动。before_sig 由调用方传入（它刚 dump 过），省一次 dump ≈300ms。"""
    before = before_sig if before_sig is not None else sig(dump())
    nap(0.15, 0.5)
    if tap_node(node) == "fail":
        die("点击注入失败", "没点下去，别接着做；bw shot 看一眼再决定", code=3)
    nodes, changed, ms = settle(before, timeout=timeout)
    if changed:
        nodes = patience(nodes)
        retitle_active(nodes)
    return nodes, changed, ms

def scroll_n(direction, n, timeout=3500):
    nodes = dump()
    before = sig(nodes)
    for i in range(n):
        if direction == "up":
            swipe_down()
        else:
            swipe_up()
        if HUMAN:
            time.sleep(random.uniform(0.25, 0.7))
            if n > 2 and i == n - 2 and random.random() < 0.3:   # 偶尔往回瞟一眼
                swipe_down(dist=random.randint(240, 420))
                time.sleep(random.uniform(0.3, 0.6))
    nodes, changed, ms = settle(before, timeout=timeout)
    if changed:
        return nodes, "moved", ms
    # 没变化：到底了，还是这个站的节点不跟着滚？给两个假设，不替模型下结论
    items = page_items(nodes)
    at_end = bool(items) and items[-1][3]["bounds"]["bottom"] >= BOTTOM - 40
    return nodes, ("end" if at_end else "stale"), ms

