            # 记账里有、面板里找不到：不能说"剩 0 个"就完事——那会让人以为账是干净的
            print(f"  另有 {len(miss)} 条在面板里找不到（可能已关掉或改了标题）："
                  + "；".join(x[:20] for x in miss[:4]))
        if left:
            sys.exit(3)
        return
    if a.op == "clean":
        titles = session_titles()
        if not titles:
            print("… 这次没开过标签")
            return
        r = close_verified(titles)
        if r["status"] in ("env", "noview"):
            die("没法清：前台不是浏览器或打不开标签管理", "先 bw go <url>，再 bw tabs clean", code=3)
        prune_state(list(r["closed"]), r["remaining"], r.get("unseen", ()),
                    inspected=r["status"] in ("ok", "partial"))
        print(f"{'✔ 清掉并核实' if r['closed'] else '… 没有需要关的'} {len(r['closed'])} 个标签"
              + ("：" + "；".join(x[:24] for x in dict.fromkeys(r["closed"])) if r["closed"] else ""))
        if r["remaining"]:
            print(f"  还剩 {len(r['remaining'])} 个没关掉，记录已保留")
            sys.exit(3)
        a11y("input", "key", "back")
        return
    return switch_tab(a.op)

def dismiss_dialog():
    """收尾时先把自己惹出来的弹窗关掉（下载确认、权限询问这类）。"""
    nodes = dump()
    w = flag(nodes)
    if "弹窗" not in w and "下载" not in w:
        return ""
    for word in ("取消", "关闭", "以后再说", "不允许"):
        n = next((x for x in web_nodes(nodes) if label(x) == word and x.get("clickable")), None)
        if n:
            tap_node(n)
            time.sleep(0.4)
            return word
    return ""

def cmd_close(a):
    keeps = list(getattr(a, "keep", None) or [])
    titles = session_titles()
    if keeps and titles:
        kl = [k.lower() for k in keeps]
        held = [t for t in titles if any(k in t.lower() for k in kl)]
        if held:
            print("· 依 --keep 留着：" + "；".join(x[:30] for x in dict.fromkeys(held)))
        titles = [t for t in titles if t not in held]
    if not titles:
        # 没有要关的也要复位拟人，并且说话（原来静默只剩一行耗时，看着像没执行）
        human_set(False)
        if keeps and session_titles():
            print(f"✔ 依 --keep 保留 {len(set(session_titles()))} 个，没有别的要关；拟人已复位")
        else:
            print("✔ 没有我开的标签要关；拟人已复位")
    if a.keep_tabs and titles:
        human_set(False)
        print(f"✔ 只清弹窗/复位拟人，标签不动（--keep-tabs）；记账 {len(set(titles))} 条留着")
    if not a.keep_tabs and titles:
        n0 = len(titles)
        r = close_verified(titles)
        if r["status"] == "env":
            if a.home:
                a11y("input", "key", "home")
            print(f"✘ 一个都没关：浏览器不在前台（现在前台={front()}，需要 {PKG}）")
            print(f"  pending={n0}  closed=0  记录没动，随时可以重跑")
            print("  下一步：手动点开 X 浏览器再说\"关掉\"；或 bw go <url> && bw close")
            sys.exit(3)
        if r["status"] == "dry":
            print(f"… 只做了核对，没有关任何标签（关闭动作在真机验收前被禁用）")
            print(f"  面板里现有 {r['before']} 张卡；记账 {n0} 条")
            print("  说明：× 的可点区域还没测准，之前点错会反而打开标签；确认后再开 CLOSE_VERIFIED_OK")
            sys.exit(3)
        if r["status"] == "changed":
            print(f"✘ 面板数量异常变化，本次不判定成功（已关 {len(r['closed'])} 个，记录保留）")
            print(f"  before={r['before']} after={r['after']} closed={len(r['closed'])} drift={r['drift']}")
            print("  说明：这中间有别的动作在同时开/关标签（你也在用手机，或弹窗/动画）。我没法确认哪个是我的。")
            print("  下一步：等手放下再说一次 bw close；或 bw tabs verify 只看不关")
            sys.exit(3)
        if r["status"] == "noview":
            print(f"✘ 一个都没关：打不开标签管理（点了\"打开的标签\"没进到卡片列表）")
            print(f"  pending={n0}  closed=0  卡片=0  记录没动")
            print("  下一步：手动点一下地址栏旁的标签数，再跑 bw close")
            sys.exit(3)
        dropped = prune_state(list(r["closed"]), r["remaining"], r.get("unseen", ()),
                              inspected=r["status"] in ("ok", "partial"), keep=keeps)
        if not r["remaining"]:
            # 数量一致性已在 close_verified 里判过（status=changed 就退 3），这里别再重复判：
            # 关的是当前标签时浏览器会补一张空白页，drift 会等于 closed，旧检查会把它误判成"数字对不上"（2026-11-22）。
            if r["closed"]:
                print(f"✔ 关掉并核实 {len(r['closed'])} 个标签："
                      + "；".join(x[:24] for x in dict.fromkeys(r["closed"])))
                print(f"  before={r['before']} after={r['after']}（面板里少了 {r['before'] - r['after']} 张）"
                      + (r.get("note") or ""))
            elif r.get("unseen"):
                # 面板里数到了卡片，但没有一张对得上我的记账：不知道是用户关了还是改了标题。
                # 记录**不清**（prune 会 tries+1，3 次才放弃），也别打 ✔。
                print(f"… 面板里没有我要找的那 {len(r['unseen'])} 个（可能你已手动关掉，或标题变了）")
                print(f"  记录保留、没清；连续 3 次都找不到才会放弃。before={r['before']} after={r['after']}")
                sys.exit(3)
            else:
                print(f"✔ 这 {n0} 个已经不在面板里了（可能你手动关过），记录已清；本次没关任何东西")
                print(f"  before={r['before']} after={r['after']}")
            human_set(False)                 # 收尾就该收干净：拟人不该粘到下一次任务
            if a.home:
                a11y("input", "key", "home")
            if r.get("unseen"):
                print(f"  另有 {len(r['unseen'])} 条没在面板里找到（可能早已关掉或改了标题），记录已保留："
                      + "；".join(x[:16] for x in r["unseen"][:4]))
            if dropped:
                print(f"  放弃 {len(dropped)} 条连续 3 次没关掉的记录：" + "；".join(x[:20] for x in dropped[:4]))
            a11y("input", "key", "back")
        else:
            print(f"✘ 只核实关掉 {len(r['closed'])} 个")
            if r["remaining"]:
                print(f"  还在面板里 {len(r['remaining'])} 个：")
                for t in r["remaining"][:6]:
                    print(f"  · {t[:40] or '（空标题，认不出）'}")
            if r.get("unseen"):
                print(f"  找不到 {len(r['unseen'])} 个（可能已手动关掉，也可能加载中改了标题）：")
                for t in r["unseen"][:6]:
                    print(f"  · {t[:40] or '（空标题）'}")
            print(f"  pending={len(r['remaining']) + len(r.get('unseen', []))}"
                  f"  before={r['before']} after={r['after']}"
                  f"  记录已保留（连续 3 次都这样才放弃）")
            sys.exit(3)
    if front() == PKG:
        gone = dismiss_dialog()
        if gone:
            print(f"✔ 顺手关掉弹窗（点了“{gone}”）")
    if a.home:
        a11y("input", "key", "home")
        time.sleep(0.6)                 # 给系统一点时间切，别让下一句读到旧前台
        print("✔ 回桌面（浏览器留在后台，随时接着看）")

def cmd_human(a):
    if a.state == "off":
        human_set(False)
        print("✔ 拟人已关（之后的动作按正常速度）")
        return
    minutes = getattr(a, "minutes", None) or HUMAN_TTL // 60
    human_set(True, minutes)
    print(f"✔ 拟人已开 · 往后 {minutes} 分钟内一直生效（每次命令自动续期），bw close 或 bw human off 结束")

def cmd_shot(a):
    p = subprocess.run(["scr", "shot"], capture_output=True, text=True)
    out = p.stdout.strip().splitlines()
    path = next((l[5:] for l in out if l.startswith("shot ")), "")
    if not path:
        die("截图失败：" + p.stdout.strip()[:120])
    print(f"shot {path}")
    print(f"url  minis://workspace/shots/{os.path.basename(path)}")

def main():
    import argparse
    ap = argparse.ArgumentParser(prog="bw", add_help=True)
    ap.add_argument("--human", action="store_true", help="拟人节奏（抖动/分段/停顿）")
    ap.add_argument("-q", "--brief", action="store_true", help="只回一行结论，不贴正文（链式执行用）")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("fast"); p.add_argument("target", nargs="+")
    p.add_argument("--max", type=int, default=3000); p.set_defaults(f=cmd_fast)

    p = sub.add_parser("go"); p.add_argument("target", nargs="+")
    p.add_argument("--new", dest="new", action="store_true", default=False)
    p.add_argument("--reuse", dest="reuse", action="store_true")
    p.add_argument("--fast", action="store_true")
    p.add_argument("--max", type=int, default=1800); p.set_defaults(f=cmd_go)
    p = sub.add_parser("read"); p.add_argument("--max", type=int, default=3000)
    p.add_argument("-n", "--count", type=int, default=0)
    p.add_argument("--up", action="store_true")
    p.add_argument("--timeout", type=int, default=4000)
    p.add_argument("--pause", action="store_true", help="拟人：读之前停一下（≤1.2s）")
    p.set_defaults(f=cmd_read)
    p = sub.add_parser("state"); p.set_defaults(f=cmd_state)
    p = sub.add_parser("tap"); p.add_argument("target"); p.add_argument("--nth", type=int)
    p.add_argument("--timeout", type=int, default=4000); p.add_argument("--max", type=int, default=1200)
    p.set_defaults(f=cmd_tap)
    p = sub.add_parser("type"); p.add_argument("text", nargs="+")
    p.add_argument("--into"); p.add_argument("--submit", action="store_true")
    p.add_argument("--timeout", type=int, default=6000); p.add_argument("--max", type=int, default=1200)
    p.set_defaults(f=cmd_type)
    p = sub.add_parser("key"); p.add_argument("name"); p.add_argument("--timeout", type=int, default=3000)
    p.add_argument("--max", type=int, default=1200); p.set_defaults(f=cmd_key)
    p = sub.add_parser("tabs"); p.add_argument("op", nargs="?")
    p.add_argument("arg", nargs="?"); p.set_defaults(f=cmd_tabs)
    p = sub.add_parser("close"); p.add_argument("--keep-tabs", action="store_true")
    p.add_argument("--keep", action="append", metavar="片段",
                   help="标题含这个片段的标签先不关（可写多次）；仍留在记账里")
    p.add_argument("--home", action="store_true", help="关完回桌面（默认不回：本机 Minis 进后台后无法再拉起浏览器）")
    p.set_defaults(f=cmd_close)
    p = sub.add_parser("find"); p.add_argument("query", nargs="+")
    p.add_argument("-n", type=int, default=1); p.add_argument("--site")
    p.add_argument("--fast", action="store_true")
    p.add_argument("--timeout", type=int, default=6000); p.add_argument("--max", type=int, default=2000)
    p.set_defaults(f=cmd_find)
    p = sub.add_parser("human"); p.add_argument("state", nargs="?", default="on")
    p.add_argument("--minutes", type=int, default=15); p.set_defaults(f=cmd_human)
    p = sub.add_parser("shot"); p.set_defaults(f=cmd_shot)

    a = ap.parse_args()
    if not hasattr(a, "f"):
        ap.print_help()
        return
    global HUMAN
    if os.environ.get("BW_HUMAN", "").strip() == "0":
        HUMAN = False                       # 硬关：连粘性状态也不认（原来会被 human_until 覆盖）
    elif getattr(a, "human", False):
        HUMAN = True
    elif human_left() > 0 and a.f.__name__ != "cmd_human":
        HUMAN = True                        # 粘性：说一次，往后整段都算
    if HUMAN and a.f.__name__ != "cmd_human":
        human_set(True)                     # 每次用都续期
        print("· 拟人", end=" ", file=sys.stderr)
    if getattr(a, "brief", False):
        BRIEF[0] = True
    if not hasattr(a, "f"):
        ap.print_help()
        return
    # cmd_human 只改本地账本，不该因为前台不是浏览器就失败（2026-11-22 实测被拦过一次）。
    if a.f.__name__ not in ("cmd_go", "cmd_close", "cmd_fast", "cmd_tabs", "cmd_human") and front() != PKG:
        if not bring_front():
            die("前台不是 X 浏览器，自动拉起也没成功", "先 bw go <url>；或手动点开 App")
        print("（自动切到浏览器前台）")
    a.f(a)
    if not BRIEF[0]:
        print(f"· 全程 {_proc_age_ms()}ms")

if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:      # 被 `| head` 截断时别甩 traceback（实测 2026-11-21）
        os._exit(0)
