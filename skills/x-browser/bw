RESULT_NOISE = re.compile(r"(Translate this result|^\d+$|^https?://|›|^Search|^ALL$|^IMAGES$|^WEB$|^VIDEOS$)")

def result_titles(nodes, query="", site=None):
    """搜索结果页上"像一条结果"的文字：可点、够长、下面还跟着摘要。
    这样能避开搜索框里的词、联想 chip、右边栏的“相关搜索”。"""
    items = page_items(nodes)
    min_y = 320
    for y, x, t, n in items:
        if re.search(r"(results|条结果|个结果|搜索结果)", t) and len(t) < 40:
            min_y = y + 8
            break
    q = re.sub(r"\s+", "", query)
    out = []
    for y, x, t, n in items:
        if y < min_y or not n.get("clickable"):
            continue
        tt = re.sub(r"\s+", "", t)
        if q and tt == q:
            continue
        if q and tt.startswith(q) and len(tt) <= len(q) + 12:
            continue                      # “把搜索词再念一遍”的联想 chip，不是结果
        if site:
            src = source_of(nodes, n)
            if not src or not src.endswith(site):
                continue                  # 给了 --site 就只认这个来源，宁可 0 条
        if not (14 <= len(t) <= 90) or CHROME.match(t) or RESULT_NOISE.search(t):
            continue
        snippet = [tt for yy, _x, tt, _n in items
                   if 20 < yy - y < 130 and not _n.get("clickable") and len(tt) > 25]
        if not snippet:
            continue
        if any(abs(y - yy) < 40 and t == tt for yy, _x, tt, _n in out):
            continue
        out.append((y, x, t, n))
    return out

DOMAIN = re.compile(r"\b([a-z0-9][a-z0-9-]*(?:\.[a-z0-9-]+)*\."
                    r"(?:gov\.cn|edu\.cn|com\.cn|org\.cn|net\.cn|cn|com|org|net|io))\b", re.I)

def source_of(nodes, title_node):
    """标题上方那行小字里通常有域名；抓不到就算了，不编。"""
    top = title_node["bounds"]["top"]
    for y, _x, t, _n in page_items(nodes):
        if top - 62 <= y <= top - 2:
            m = DOMAIN.search(t)
            if m:
                return m.group(1).lower()
    return ""

def cmd_find(a):
    """搜索 → 打开第 N 条结果 → 把正文拿回来。一条命令干完三件事。"""
    q = " ".join(a.query)
    if a.site:
        q = f"{q} site:{a.site}"
    t0 = time.time()
    nodes, how, ms, note = go(q, new_tab=True, human_dwell=not a.fast)
    # 落到搜索页才算数：intent 有时停在原页面不动（本机实测），那就用地址栏再走一次
    ttl = bar_text(nodes) or ""
    if not re.search(r"搜索|Search|必应|Bing|百度", ttl):
        n2, ms2 = via_bar(_url_of(q))
        if n2 is not None:
            nodes, how, ms, note = n2, "地址栏", ms2, "（搜索页没开，改走地址栏）"
    titles = result_titles(nodes, re.sub(r"\s+", "", q.split(" site:")[0]), a.site)
    # 本机（Bing 移动版）结果块是延迟渲染的：刚落地只有搜索框 132 字，6–8s 后才出条目。
    # 原来只解析一次，直接判成"0 条结果"，把"还没画完"当成"没有结果"（2026-11-21 实测）。
    t1 = time.time()
    while len(titles) < a.n and time.time() - t1 < 4:
        time.sleep(0.8)
        nodes = dump()
        titles = result_titles(nodes, re.sub(r"\s+", "", q.split(" site:")[0]), a.site)
    if len(titles) < a.n:
        # 本机必应移动版：顶部先给一张广告卡，真结果在下面一屏。往下翻一次再解析。
        for _ in range(2):
            if len(titles) >= a.n:
                break
            swipe_up()
            t2 = time.time()
            while time.time() - t2 < 3:
                time.sleep(0.6)
                nodes = dump()
                titles = result_titles(nodes, re.sub(r"\s+", "", q.split(" site:")[0]), a.site)
                if len(titles) >= a.n:
                    break
    if len(titles) < a.n:
        why = f"（--site {a.site} 下 0 条命中）" if a.site and not titles else f"（只有 {len(titles)} 条像结果的）"
        print(f"… 没打开任何页 {why}，下面是搜索结果：")
        print(render(nodes, maxc=a.max))
        sys.exit(2)                      # 一条都没开就是硬失败：exit 0 会让 a && b 接着跑
    pick = titles[a.n - 1]
    src = source_of(nodes, pick[3])
    try:
        nodes, ch, ms2 = tap_and_wait(pick[3], a.timeout)
    except SystemExit:
        print("   ✘ 点不开这一条，下面是搜索结果：")
        print(render(nodes, maxc=a.max))
        sys.exit(2)
    lab = pick[2][:36]
    src = f" · 来源 {src}" if src else " · 来源未识别"
    print(f"✔ 搜“{q}” → 第 {a.n}/{len(titles)} 条《{lab}》{src} · {int((time.time()-t0)*1000)}ms")
    print(render(nodes, maxc=a.max))

