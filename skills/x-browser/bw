def switch_tab(which):
    st = load_state()
    tabs = st.get("tabs", [])
    if not tabs:
        die("记账里没有我开的标签", "用 bw go 开一个，或 bw tabs 看看")
    target, idx = None, None
    if which.isdigit():
        idx = int(which) - 1
        if 0 <= idx < len(tabs):
            target = tabs[idx]
    else:
        for i, t in enumerate(tabs):
            if which[:12] in t["title"] or which in t["title"]:
                target, idx = t, i
                break
    if not target:
        print(f"✘ 记账里没有 “{which}”，可选：")
        for i, t in enumerate(tabs, 1):
            print(f"  {i}. {t['title'][:40]}")
        sys.exit(3)
    if not open_tabview():
        die("没能打开标签管理")
    nodes = dump()
    rows = tab_rows(nodes)
    hit = next((r for r in rows if target["title"][:10] in label(r)), None)
    if not hit:
        rows = tab_rows(dump())
        hit = next((r for r in rows if which in label(r)), None)
    if not hit:
        a11y("input", "key", "back")
        die(f"标签列表里没找到《{target['title'][:20]}》", "它可能已经被关掉了；bw go 重新打开")
    b = hit["bounds"]
    a11y("tap", "xy", str((b["left"] + b["right"]) // 2), str((b["top"] + b["bottom"]) // 2))
    nodes, changed, ms = settle(sig(nodes), timeout=4000)
    got = bar_text(nodes)
    if not got or got[:8] not in target["title"]:
        a11y("input", "key", "back")
        die(f"点了但没切过去（现在是《{got or '?'}》）", "重试一次；还不行就用 bw go 重开")
    st["active"], st["last"] = idx, target["title"]
    save_state(st)                    # 切标签只改指针，不往记账里追加
    print(f"✔ 切到《{got}》 · {ms}ms")
    print(render(nodes, maxc=1200))

