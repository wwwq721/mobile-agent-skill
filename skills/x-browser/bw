#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""bw — 接管本机的 X 浏览器（com.mmbox.xbrowser）。

根本目的（用户原话，不得改写）：
    目的：让 AI 快速高效的用用户手机上那个浏览器，并且当我提出拟人化操作是，
    可以更拟人化使用浏览器。（并且用完最好能把没用的界面关闭）

由此推出的三条实现约束（作者的推论，可以改）：
- 登录态在他自己的浏览器里，所以不能换成别的容器；
- 默认求快，拟人是显式开关（--human / 粘性状态）；
- 收尾只关自己开的标签，不碰用户的。

三条契约（所有命令都遵守）：
  1. 第一行就是结论；失败前一定 render 一次屏幕（失败不给屏 = 模型多花一轮）。
  2. 效果不确定用 exit 3（没变化/没打开/没关成），硬失败 exit 2，成功 0 —— 所以 && 链会自己停。
  3. 每个动作都要自证：变了没、标题是什么、来源是哪；不许打没验证过的 ✔。

设计取舍（改之前先读）：
- 不用插件、不装桥、不碰 WebView 调试口，只走无障碍节点 + 系统截屏，所以和 App 版本无关。
- 导航优先用 intent（40ms 到达），只为自己开的标签记账；地址栏输入是退路。
- 节点是主通道，节点薄的站点（知乎/重 JS）才截图交给模型看，截图很贵。
- 所有"点/写"都必须在同一次 dump 之后立刻做：nodeId 每 dump 一次全变。

用法见 SKILL.md。这里是实现。
"""
import contextlib
import fcntl
import functools
import json
import os
import random
import re
import subprocess
import sys
import time

_T0 = time.time()          # 进程起点：全程计时从这儿算，含 front()/dump() 与模块导入之后的一切

PKG = "com.mmbox.xbrowser"
# 屏幕尺寸不再写死：第一帧 dump 里实测根节点（本机 1280x2772，旧机 1080x2400）。
W, H = 1080, 2400
_GEOM = {"done": False}
# 账本必须是**跨会话**的：浏览器标签是全局的，账本放在某个会话的 workspace 里，
# 另一个会话跑 close 就会看不见这些标签、永远关不掉（2026-11-22 复查发现）。
STATE = "/var/minis/shared/bw/session.json"
_OLD_STATE = "/var/minis/workspace/bw/session.json"
HUMAN = (os.environ.get("BW_HUMAN", "").strip().lower() in ("1", "true", "on", "yes"))

# ---------- 设备 ----------
def a11y(*args, t=20):
    try:
        p = subprocess.run(["android-a11y-cli", *args],
                           capture_output=True, text=True, timeout=t)
        out = p.stdout.strip()
        if out.startswith("{"):
            return json.loads(out)
        return {"ok": False, "error": {"code": "NO_JSON", "message": (out + p.stderr)[:200]}}
    except Exception as e:                                    # noqa: BLE001
        return {"ok": False, "error": {"code": "EXC", "message": str(e)[:160]}}

_IN_DIE = [False]

def _proc_age_ms():
    """进程真实年龄（毫秒），含解释器启动。
    只用 time.time() 会漏掉 exec/import 的几百毫秒（本机实测 ~380ms），自报就比用户实测小一截。
    /proc/uptime 在 PRoot 里不可读，改用 CLOCK_BOOTTIME（与 stat 的 starttime 同一时间基）。"""
    try:
        fld = open("/proc/self/stat").read().rsplit(") ", 1)[1].split()
        start = float(fld[19]) / os.sysconf("SC_CLK_TCK")
        return int((time.clock_gettime(time.CLOCK_BOOTTIME) - start) * 1000)
    except Exception:                                          # noqa: BLE001
        return int((time.time() - _T0) * 1000)


def die(msg, hint="", code=2):
    """报错并回一屏——失败时不给屏幕，模型就得再花一轮才知道发生了什么。"""
    print(f"✘ {msg}" + (f"\n  {hint}" if hint else ""))
    if not _IN_DIE[0]:
        _IN_DIE[0] = True
        try:
            if front() == PKG:
                print(render(dump(), maxc=800))
        except SystemExit:
            pass
        except Exception:                                      # noqa: BLE001
            pass
    sys.exit(code)

def dump():
    d = a11y("ui", "dump")
    if not d.get("ok"):
        e = d.get("error") or {}
        if e.get("code") == "SERVICE_NOT_RUNNING":
            die("无障碍没开", "让用户去 设置→无障碍 打开 Minis")
        die(f"dump 失败 {e.get('code')} {e.get('message','')}")
    nodes = (d.get("data") or {}).get("nodes") or []
    _measure(nodes)
    return nodes

def _measure(nodes):
    """第一帧实测屏幕几何；换机不用改常量。
    判据：根节点 bounds 最大值＝屏幕右下；工具栏上沿＝包内最靠下的可点节点 top（占比 >0.85）；
    地址栏下沿＝顶部宽条（宽 >0.55W、高 90–190、top <0.25H）的 bottom，找不到就按 0.1H。"""
    global W, H, TOP, BOTTOM
    if _GEOM["done"]:
        return
    right = bottom = 0
    for n in nodes:
        b = n.get("bounds") or {}
        right = max(right, b.get("right", 0))
        bottom = max(bottom, b.get("bottom", 0))
    if right > 400 and bottom > 800:
        W, H = right, bottom
    tb = [b.get("top", 0) for n in nodes
          if n.get("packageName") == PKG and n.get("clickable")
          for b in [n.get("bounds") or {}] if b.get("top", 0) > 0.85 * H]
    BOTTOM = min(tb) if tb else int(0.93 * H)
    ab = [b.get("bottom", 0) for n in nodes
          if n.get("packageName") == PKG and n.get("clickable")
          for b in [n.get("bounds") or {}]
          if b.get("right", 0) - b.get("left", 0) > 0.55 * W
          and 90 <= b.get("bottom", 0) - b.get("top", 0) <= 190 and b.get("top", 9e9) < 0.25 * H]
    TOP = min(ab) if ab else int(0.10 * H)
    if sum(1 for n in nodes if n.get("packageName") == PKG) >= 5:
        _GEOM["done"] = True                    # 首帧若是状态栏/别的 App，量出来的尺寸是错的，下次重建

def _open(args, t=15):
    """android-open 一律带超时：熄屏或系统卡住时它会挂住，调用方等不到任何返回。"""
    try:
        return subprocess.run(["android-open", *args], capture_output=True, text=True, timeout=t)
    except Exception:
        return None

def front():
    d = a11y("ui", "info")
    return (d.get("data") or {}).get("packageName", "?")

# ---------- 页面读取 ----------
# 由 _measure() 首次 dump 时实测：本机 1280x2772 → TOP=295 / BOTTOM=2574；旧机 1080x2400 → 240 / 2255
BOTTOM = 2255          # 底部工具栏上沿
TOP = 240              # 地址栏下沿
# 页面外壳（导航条/工具栏/翻译提示）不算正文，读的时候剔掉
CHROME = re.compile(r"^(Translate this result|网站设置|广告|关闭|跳转|下载|打开 ?App|打开APP|"
                    r"Sign in|Skip to content|Accessibility Feedback|Back to .* search|"
                    r"国内版|国际版|Search Filter|ALL|IMAGES|WEB|VIDEOS|Global web icon|"
                    r"Turn off Hover Translation.*|Search|Images|Videos|More|"
                    r"Account Rewards and Preferences|Microsoft Rewards|Settings and quick links)$")

def web_nodes(nodes):
    """只要网页正文区里的节点，工具栏/状态栏/通知栏一律剔除。"""
    out = []
    for n in nodes:
        b = n.get("bounds") or {}
        if n.get("packageName") != PKG:
            continue
        if b.get("top", 0) < TOP or b.get("bottom", 0) > BOTTOM:
            continue
        out.append(n)
    return out

def label(n):
    t = (n.get("text") or "").strip()
    if not t:
        t = (n.get("contentDesc") or "").strip()
    return re.sub(r"\s+", " ", t)

def page_items(nodes):
    """(y, x, text, node) 按阅读顺序；同位置的重复文本只留一份。"""
    seen, items = set(), []
    for n in web_nodes(nodes):
        t = re.sub(r"\s*Translate this result$", "", label(n))
        if not t or CHROME.match(t):
            continue
        # 内联 SVG/图片的 data URI 会当成"正文"打出来（实测一次 7000 字全是 svg 路径），直接丢
        if t.startswith("svg+xml") or "%3Csvg" in t[:40] or (len(t) > 1200 and re.match(r"^[a-z]+/[a-z0-9+.]+;", t)):
            continue
        b = n["bounds"]
        k = (t, b["top"] // 6)
        if k in seen:
            continue
        seen.add(k)
        items.append((b["top"], b["left"], t, n))
    items.sort(key=lambda x: (x[0] // 8, x[1]))
    return items

def bar_text(nodes):
    """地址栏里的那行字：正常时是页面标题，编辑态里是 URL。"""
    cand = [n for n in nodes if n.get("packageName") == PKG
            and (n.get("bounds") or {}).get("top", 999) < 230
            and (n.get("text") or "").strip()]
    return label(cand[0])[:80] if cand else ""

def text_of(nodes, maxc):
    out, size = [], 0
    for _y, _x, t, _n in page_items(nodes):
        out.append(t)
        size += len(t)
        if size >= maxc:
            break
    return "\n".join(out)

def sig(nodes):
    items = page_items(nodes)
    return (bar_text(nodes), len(items), "|".join(t for _y, _x, t, _n in items[:12]))

def patience(nodes, tries=2):
    """页面还在长：字少就再等两口气，别把空壳交出去。"""
    for _ in range(tries):
        if len(text_of(nodes, 10 ** 6)) >= 80:
            break
        time.sleep(0.9)
        nodes = dump()
    return nodes

def settle(prev, timeout=6000, need_chars=300):
    """等页面停住：签名变了、连续两次一样、而且不是"还在转圈"的空壳。
    空壳页（只有导航条文字）继续等到超时——早一回合交给模型，就得再跑一回合。"""
    t0 = time.time()
    last, changed, stable = None, False, 0
    while True:
        nodes = dump()
        s = sig(nodes)
        chars = len(text_of(nodes, 10 ** 6))
        if prev is None:
            changed = chars >= need_chars        # 没基准：有正文就算变了
        elif s != prev:
            changed = True
        stable = stable + 1 if s == last else 0
        last = s
        el = (time.time() - t0) * 1000
        if changed and stable >= 1 and el >= 450 and (chars >= need_chars or (el > 4200 and chars >= 80)):
            return nodes, True, int(el)
        if el > timeout:
            return nodes, changed, int(el)
        time.sleep(0.14 if HUMAN else 0.1)

INTERCEPT = re.compile(r"(验证码|滑块|安全验证|人机验证|环境异常|访问异常|访问受限|"
                       r"操作频繁|请在微信|页面不存在|内容不存在|已被删除)")

def flag(nodes):
    """这一屏能不能信：拦截页 / 登录墙 / 空壳，三种都是"别接着往下做"的信号。"""
    txt = text_of(nodes, 4000)
    m = INTERCEPT.search(txt)
    if m:
        return f"⛔ 拦截页「{m.group(1)}」——正文不是真内容，要人介入"
    wall = re.search(r"(登录后查看|登录后阅读|扫码登录|请先登录|请登录|登录即可|未登录|"
                     r"登录/注册|登录注册|Sign in to continue|Log in to continue)", txt)
    if (wall or re.search(r"(登录|Verify|Just a moment)", bar_text(nodes))) and len(txt) < 400:
        return "⛔ 像是登录墙——X 浏览器里的会话没登进去，需要你在手机上登一次"
    if "文件下载" in txt and "取消" in txt:
        return "⚠ 这是下载弹窗，不是网页——点“取消”退回去，别让文件落盘"
    if txt.strip().startswith("{") and re.search(r'"code"\s*:', txt):
        return "⚠ 这页是接口返回的 JSON（不是正文），多半是参数被站点拒了"
    if not txt.strip():
        return "⚠ 0 字：整屏被裁（PDF/canvas）或还没渲染，用 bw shot 看一眼"
    return ""

BRIEF = [False]

def render(nodes, maxc=2500, head=0, force=False):
    items = page_items(nodes)
    txt = text_of(nodes, maxc)
    warn = flag(nodes)
    head_line = f"《{bar_text(nodes) or '?'}》 {len(items)} 块 / {len(txt)} 字"
    if BRIEF[0] and not force:          # 链式执行：中间步只留一行
        return "\n".join(([warn] if warn else []) + [head_line])
    lines = ([warn] if warn else []) + [head_line]
    if head:
        txt = "\n".join(txt.splitlines()[:head])
    return "\n".join(lines + [txt]) if txt else "\n".join(lines + ["（这一屏读不到文字——用 bw shot 看图）"])

# ---------- 拟人 ----------
def nap(lo=0.18, hi=0.45, scale=1.0):
    if HUMAN:
        time.sleep(random.uniform(lo * 3, hi * 3) * scale)

def jitter_point(b, pad=0.28):
    """点控件内部偏一点，别总是正中靶心。"""
    w = max(1, b["right"] - b["left"])
    h = max(1, b["bottom"] - b["top"])
    if not HUMAN:
        return (b["left"] + b["right"]) // 2, (b["top"] + b["bottom"]) // 2
    x = int(b["left"] + w * random.uniform(pad, 1 - pad))
    y = int(b["top"] + h * random.uniform(pad, 1 - pad))
    return x, y

def tap_node(n):
    """点一个节点。拟人模式下只许真实触摸（tap xy）：
    ACTION_CLICK 不产生触摸事件，页面能看出"没人碰过就被点了"；而且失败时会静默成功。
    宁可报错让调用方知道，也不要用注入点击伪装成人手。"""
    b = n["bounds"]
    if HUMAN:
        for _ in range(2):                     # 抖动点偏了再取一次，不无限重试
            x, y = jitter_point(b)
            if a11y("tap", "xy", str(x), str(y)).get("ok"):
                return "xy"
            nap(0.1, 0.3)
        return "fail"
    r = a11y("tap", "node", n["nodeId"])
    if r.get("ok"):
        return "node"
    x, y = jitter_point(b)
    return "xy" if a11y("tap", "xy", str(x), str(y)).get("ok") else "fail"

def swipe_up(dist=None, dur=None):
    """往上滑（看下面的内容）。人手不会每次都同一条直线、同一个速度。"""
    if HUMAN:
        d = dist or random.randint(int(H * 0.42), int(H * 0.68))
        dur = dur or random.randint(260, 620)
        x = random.randint(W // 4, W * 3 // 4)
        drift = random.randint(-40, 40)
        a11y("gesture", "swipe", str(x), str(1200 + d // 2),
             str(x + drift), str(1200 - d // 2), "--duration", str(dur))
    else:
        d = dist or 900
        a11y("gesture", "swipe", "540", str(1200 + d // 2), "540", str(1200 - d // 2),
             "--duration", "320")

def swipe_down(dist=None):
    if HUMAN:
        d = dist or random.randint(int(H * 0.35), int(H * 0.6))
        x = random.randint(W // 4, W * 3 // 4)
        a11y("gesture", "swipe", str(x), str(1200 - d // 2),
             str(x + random.randint(-40, 40)), str(1200 + d // 2),
             "--duration", str(random.randint(260, 560)))
    else:
        d = dist or 900
        a11y("gesture", "swipe", "540", str(1200 - d // 2), "540", str(1200 + d // 2),
             "--duration", "320")

# ---------- 标签记账 ----------
def load_state():
    """读账本。**坏文件不静默清零**：清零＝开过的标签永远关不掉，是 close 假成功的第二条根因。
    文件不存在 → 空账（正常）；解析失败 → 改名留证 + 报错退出，让调用方看见。"""
    if not os.path.exists(STATE) and os.path.exists(_OLD_STATE):
        try:                                    # 老位置（某会话的 workspace）一次性搬过来
            os.makedirs(os.path.dirname(STATE), exist_ok=True)
            os.replace(_OLD_STATE, STATE)
        except Exception:                       # noqa: BLE001
            pass
    if not os.path.exists(STATE):
        return {"tabs": [], "active": None}
    try:
        st = json.load(open(STATE))
    except Exception as e:                                     # noqa: BLE001
        bad = f"{STATE}.bad-{int(time.time())}"
        try:
            os.replace(STATE, bad)
        except Exception:                                      # noqa: BLE001
            bad = "(改名失败)"
        print(f"✘ 账本损坏（{type(e).__name__}），已另存为 {bad}\n  下一步：bw tabs 看当前账本；需要重记就用 bw go 重新打开页面")
        sys.exit(2)
    st.setdefault("tabs", [])
    st.setdefault("active", None)
    return st

HUMAN_TTL = 900          # 15 分钟没用就自动失效，别污染下次任务

_LOCK = {"fd": None, "depth": 0}

@contextlib.contextmanager
def state_lock():
    """会话间互斥：同一时刻只允许一个进程改账本（可重入）。
    实测后果（2026-11-23）：两进程各 note_tab 25 次 → FileNotFoundError 崩在写临时文件；
    不崩时后写者赢，前面的记录整批丢失。"""
    if _LOCK["depth"] == 0:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        fd = os.open(STATE + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        _LOCK["fd"] = fd
    _LOCK["depth"] += 1
    try:
        yield
    finally:
        _LOCK["depth"] -= 1
        if _LOCK["depth"] == 0:
            try:
                fcntl.flock(_LOCK["fd"], fcntl.LOCK_UN)
            finally:
                os.close(_LOCK["fd"])
                _LOCK["fd"] = None

def with_lock(fn):
    """给"读—改—写"整段加锁；可重入，所以 note_tab 被 retitle_active 调用也没问题。"""
    @functools.wraps(fn)
    def wrapper(*a, **k):
        with state_lock():
            return fn(*a, **k)
    return wrapper

def save_state(st):
    """原子写：先写 .tmp 再 replace。
    半截 JSON 会被 load_state 当成空账，而空账的后果是"开过的标签再也关不掉"——所以这一步不能省。"""
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = f"{STATE}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(st, f, ensure_ascii=False)
    os.replace(tmp, STATE)

@with_lock
def note_tab(title):
    """记一个"这是我开的标签"。active 指向它，后面它改名了还能认出来。"""
    st = load_state()
    # 标题为空也要记：误触底栏"主页"开的空白页，不记账就永远关不掉
    st["tabs"] = (st["tabs"] + [{"title": title or "", "ts": int(time.time())}])[-20:]
    st["active"] = len(st["tabs"]) - 1
    st["last"] = title
    save_state(st)

@with_lock
def rename_active(title):
    """复用同一个标签里跳了页：就地改名，而不是再追加一条。
    追加会在账本里堆出一串同一张卡的旧标题，后面每次 close 都要为它们逐个失败（2026-11-22 实测 1 张卡 4 条记录）。"""
    st = load_state()
    if not title:
        return
    idx = st.get("active")
    if idx is None or not st["tabs"] or not (0 <= idx < len(st["tabs"])):
        return note_tab(title)
    st["tabs"][idx]["title"] = title
    st["last"] = title
    save_state(st)

@with_lock
def retitle_active(nodes):
    """在这个"我开的"标签里又跳了页：把新标题也记一笔。
    搜索结果常在新标签里打开，所以宁可按两个标题各关一次，也不漏关。"""
    st = load_state()
    title = bar_text(nodes)
    if st.get("active") is None or not title:
        return
    idx = st.get("active")
    if idx is not None and 0 <= idx < len(st["tabs"]) and st["tabs"][idx]["title"] == title:
        return                                   # 就是这条，不重复记
    note_tab(title)

@with_lock
def human_set(on, minutes=15):
    st = load_state()
    if on:
        st["human_until"] = int(time.time()) + minutes * 60
    else:
        st["human_until"] = 0
    save_state(st)

def human_left():
    return max(0, load_state().get("human_until", 0) - int(time.time()))

# ---------- 动作 ----------
def _url_of(target):
    if re.match(r"^(https?|file|about):", target):
        return target
    if "." in target and " " not in target:
        return "https://" + target
    return "https://cn.bing.com/search?q=" + target.replace(" ", "+")

def via_intent(url, wait_ms=6500):
    # 基准只在"浏览器在前台"时才有意义：Minis 在前台时 dump 到的是 Minis 的屏，
    # 拿它当 prev 会让"变了/没变"全靠运气（子 agent 2026-11-22 实测）。
    prev = sig(dump()) if front() == PKG else None
    _open(["intent:" + url + "#Intent;action=android.intent.action.VIEW;package=" + PKG + ";end"])
    t0 = time.time()
    while time.time() - t0 < 4:
        if front() == PKG:
            break
        time.sleep(0.1)
    nodes, changed, ms = settle(prev, timeout=wait_ms)
    nodes = patience(nodes)
    return nodes, ms, changed

MINIS = "com.openminis.app"

def bring_minis_front(timeout=4.0):
    """把 Minis 自己切回前台，好让 VIEW intent 被系统放行（后台启动会被静默 cancel）。
    做法：Recents → 点"Minis"那张卡片。recents 的卡片标签形如 `Minis,未加锁`。
    失败就返回 False，调用方退回"新建标签+地址栏"。
    2026-11-22 实测：这一步能成功，随后 intent 697ms 落地。"""
    if front() == MINIS:
        return True
    if os.environ.get("BW_NO_FRONT", "").strip() == "1":
        return False
    try:
        if not a11y("input", "key", "recents").get("ok"):
            return False
    except Exception:                                            # noqa: BLE001
        return False
    card = None
    t0 = time.time()
    while time.time() - t0 < 2.5:
        time.sleep(0.4)
        for n in dump():
            lab = label(n)
            b = n.get("bounds") or {}
            # 只要大卡片：状态栏那颗"Minis:0:12"也含 Minis，但很小
            if "Minis" in lab and (b.get("right", 0) - b.get("left", 0)) > 0.3 * W \
                    and (b.get("bottom", 0) - b.get("top", 0)) > 0.3 * H:
                card = n
                break
        if card:
            break
    if not card:
        return False
    b = card["bounds"]
    a11y("tap", "xy", str((b["left"] + b["right"]) // 2), str((b["top"] + b["bottom"]) // 2))
    t0 = time.time()
    while time.time() - t0 < timeout:
        if front() == MINIS:
            return True
        time.sleep(0.2)
    return False

def addr_bar(nodes):
    """找地址栏（首页是居中的搜索框，页面内是顶部条）：宽 >0.55W、高 90–190、top <0.6H、
    且左右各有留白（列表行是全宽，靠这条区分）的最宽可点节点。
    返回点击中心 (x,y)；找不到返回 None。换机/换布局都不该写死坐标。"""
    best = None
    for n in nodes:
        b = n.get("bounds") or {}
        if n.get("packageName") != PKG or not n.get("clickable"):
            continue
        w = b.get("right", 0) - b.get("left", 0)
        h = b.get("bottom", 0) - b.get("top", 0)
        if w < 0.55 * W or not (90 <= h <= 190) or b.get("top", 9e9) > 0.6 * H:
            continue
        if b.get("left", 0) < 0.02 * W or b.get("right", 0) > 0.98 * W:   # 全宽＝列表行，不是地址栏
            continue
        if best is None or w > best[0]:
            best = (w, ((b["left"] + b["right"]) // 2, (b["top"] + b["bottom"]) // 2))
    return best[1] if best else None

def _bar_cleanup():
    """地址栏没走通后的收尾：把浮层/键盘收起来。
    不收的后果（2026-11-22 实测）：下一次 go 看到地址栏里还留着我们打的 URL，
    判成"地址栏已是目标域名"→ 假成功；而且面板点不开（点到了联想词列表）。"""
    try:
        a11y("input", "key", "back")
        time.sleep(0.4)
    except Exception:                                        # noqa: BLE001
        pass

def via_bar(url):
    """在当前标签里改地址（不留新标签）。慢一点，但不会堆出一堆页。"""
    prev = sig(dump())
    spot = addr_bar(dump())
    if not spot:
        return None, 0
    a11y("tap", "xy", str(spot[0]), str(spot[1]))
    ed = None
    t0 = time.time()
    while time.time() - t0 < 2500:
        nodes = dump()
        ed = [n for n in nodes if n.get("editable") and n.get("packageName") == PKG]
        if ed:
            break
        time.sleep(0.12)
    if not ed:
        _bar_cleanup()                   # 点了地址栏却没出输入框：也要退回去
        return None, 0
    if not a11y("input", "text", url, "--node", ed[0]["nodeId"]).get("ok"):
        _bar_cleanup()
        return None, 0
    nodes = dump()
    ms = 0                                # 三条提交路都没走通时也要能 return（2026-11-22 撞过 UnboundLocal）
    prev_title = prev[0] if isinstance(prev, tuple) else ""   # 打字前的页面标题
    if ime_up(nodes):                     # 地址栏的“前往”就是键盘右下角那颗
        # 三条路依次试：键盘 H-186（本机 Sogou）→ 地址栏右侧的“前往”箭头 → 键盘 H-100（旧机）。
        # 本机顶部地址栏在某些布局下打完字键盘会自己收起，这时只能点箭头（2026-11-22 实测）。
        for act in ("enter186", "arrow", "enter100"):
            if act == "arrow":
                if ime_up():
                    a11y("input", "key", "back")      # 先收键盘，箭头才露出来
                    time.sleep(0.3)
                a11y("tap", "xy", str(int(W * 0.9375)), str(spot[1]))
            elif act == "enter186":
                if not press_ime_enter(H - 186):
                    continue
            else:
                if not press_ime_enter(H - 100):
                    continue
            # 落地判据要三条一起满足：键盘收起、标题变了、页面内容真的变了。
            # 只查"标题非空"会把"地址栏里还留着旧标题"当成打开成功（2026-11-22 实测 1490ms 假成功）。
            # 落地判据：键盘收起 + 地址栏不再显示"我刚打的字"。
            # 不能用"标题变了"：同站不同页常常同名（example.com / example.org 都叫 Example Domain），
            # 也不能只看"内容变了"：内容可能一模一样（2026-11-22 实测两次假失败/一次假成功）。
            t1 = time.time()
            landed = False
            while time.time() - t1 < 6:
                time.sleep(0.3)
                nn = dump()
                bt = bar_text(nn)
                typed = {url.strip(), url.strip() + "/"}
                if not ime_up(nn) and bt and bt not in typed \
                        and bt not in ("新标签页", "主页", "搜索或网址"):
                    landed = True
                    break
            if landed:
                nodes, _changed, ms = settle(prev, timeout=4000)
                return nodes, ms
        _bar_cleanup()                   # 键盘还在、页面没跳：收起来再交给调用方
        return None, ms
    btn = [n for n in nodes if n.get("packageName") == PKG and n.get("clickable")
           and (n.get("bounds") or {}).get("top", 999) < TOP - 5
           and 800 <= (n.get("bounds") or {}).get("left", 0) <= 950]
    if not btn:
        a11y("input", "key", "back")
        return None, 0
    tap_node(btn[0])
    nodes, changed, ms = settle(prev, timeout=8000)
    if not changed:
        return None, ms
    return nodes, ms

def open_new_tab():
    """面板里点"新建标签"，回到空白页。失败返回 False。"""
    if not open_tabview():
        return False
    nodes = dump()
    tile = next((n for n in nodes if "新建标签" in ((n.get("text") or "") + (n.get("contentDesc") or ""))
                 and n.get("packageName") == PKG), None)
    if not tile:
        return False
    tap_node(tile)
    t0 = time.time()
    while time.time() - t0 < 3:
        time.sleep(0.4)
        if not in_tabview(dump()):
            return True
    return False

def _bar_retry(url, tries=1):
    """intent 没落地时改走地址栏：新标签页/首页还在动画里，第一次常摸不到地址栏，故重试一次。"""
    ms = 0
    for i in range(tries):
        time.sleep(0.5 if i == 0 else 0.8)
        nodes, ms = via_bar(url)
        if nodes is not None:
            return nodes, ms
    return None, ms

def go(target, new_tab=True, human_dwell=True):
    """开页并记账。改这里必须连带改 note_tab/retitle_active：只记"确认落地"的。"""
    nodes, how, ms, note = _go_impl(target, new_tab=new_tab, human_dwell=human_dwell)
    title = bar_text(nodes) if nodes else ""
    if nodes is not None and not title and how in ("地址栏", "新标签+地址栏", "intent"):
        note_tab("")                            # 没标题也要记：否则这张卡永远关不掉
    elif title:
        if new_tab:
            note_tab(title)                  # 新开的一页：一条记录
        elif how == "地址栏":
            rename_active(title)             # 同一标签里改地址：就地改名，别堆旧标题
        else:
            retitle_active(nodes)            # 不确定是不是同一个标签：宁可多记一条
    return nodes, how, ms, note

def _go_impl(target, new_tab=True, human_dwell=True):
    url = _url_of(" ".join(target) if isinstance(target, list) else target)
    nodes, ms, how, note = None, 0, "intent", ""
    # 前提：**调用方在前台**，否则任何 startActivity 都会被系统拦。
    # 前台既不是 Minis 也不是浏览器（桌面/别的 App）时，先把自己切回前台——这一步 a11y 随时能做。
    if front() not in (MINIS, PKG):
        bring_minis_front()
    # 需要动浏览器界面（新建标签、地址栏）的分支，得先让浏览器在前台
    needs_ui = (not new_tab) or (new_tab and bool(re.search(r"[#;]", url))) or bool(HUMAN and new_tab)
    if needs_ui and front() != PKG:
        bring_front()
    if HUMAN and new_tab and not re.search(r"[#;]", url):
        # 拟人：人在地址栏里打字再前往。慢，但屏幕上有"输入"这个过程。
        # new_tab=True 时必须**先开一张新标签**再打字：via_bar 改的是当前标签，
        # 不加这一步会把用户正看着的那页顶掉（2026-11-22 复查发现）。
        if open_new_tab():
            nodes, ms = via_bar(url)
            if nodes is not None:
                return nodes, "地址栏", ms, "（拟人：新建标签后走地址栏）"
        nodes = None                            # 没走通就退回其他路径，别把任务卡死
        note = "（拟人：地址栏没走通，改用其他路径）"
    if new_tab and re.search(r"[#;]", url):
        # intent 会截断 # 与 ;，只能走地址栏；但**必须先开一张新标签**，
        # 否则改的是当前标签——用户正看着的那页会被顶掉（2026-11-23 审计）。
        if open_new_tab():
            nodes, ms = via_bar(url)
            if nodes is not None:
                return nodes, "新标签+地址栏", ms, "（URL 含 # 或 ;，新建标签后走地址栏）"
            # 地址栏没走通：可以退回 intent，但**锚点会丢**，而且会再开一张页。这条必须在输出里说。
            note = "（地址栏没走通，退回 intent：这一页的 # 锚点/; 参数保不住）"
    elif not new_tab:
        nodes, ms = via_bar(url)
        if nodes is not None:
            how = "地址栏"
            note = "（URL 含 # 或 ;，改走地址栏）" if new_tab else ""
    if nodes is None and front() == PKG and bring_minis_front():
        # 浏览器在前台 ⇒ Minis 在后台 ⇒ 系统会静默 cancel 这次 startActivity。
        # 先把自己切回前台（Recents → Minis），切成功就走下面的 intent 快路径；
        # 切不回来（没权限/找不到卡片）才退回"新建标签+地址栏"。
        note = note or "（先把 Minis 切回前台，再用 intent）"
    elif nodes is None and front() == PKG:
        if new_tab:
            if open_new_tab():
                n4, ms4 = via_bar(url)
                if n4 is not None:
                    return n4, "新标签+地址栏", ms4, "（Minis 在后台，intent 必被拦）"
            die(f"没打开：{url}", "新建标签后地址栏也没走通；bw shot 看一眼当前屏，或手动点开浏览器再说一次。", code=3)
        die(f"没确认打开：{url}",
            f"复用模式下地址栏没走通（当前页《{bar_text(dump()) or '空白'}》）。可以试 bw go --new。", code=3)
    if nodes is None and front() != PKG:
        # 只有 Minis 在前台时 VIEW intent 才会被系统放行（2026-11-22 子 agent 矩阵实测：
        # 浏览器在前台＝Minis 在后台＝Android 10 直接 cancel 后台启动，且 startActivity 不报错）。
        prev_title = bar_text(dump())
        nodes, ms, changed = via_intent(url, wait_ms=3500)
        title = bar_text(nodes)
        how = "intent"
        # 标题栏常常比正文慢半拍。正文已经够厚就先认这一页，别为标题再等 1.4s；
        # 真空壳才补一次短等（原来固定 2×0.7s + 2 次 dump）。
        if title in ("", "新标签页", "主页", "搜索或网址") and len(text_of(nodes, 10 ** 6)) < 300:
            time.sleep(0.7)
            nodes = dump()
            title = bar_text(nodes)
        if title in ("", "新标签页", "主页", "搜索或网址"):
            # 有的浏览器版本吃掉 VIEW intent（只开一个新标签页、不落地 URL）：
            # 先试一次地址栏，别直接判死；地址栏也走不通才报错。
            n2, ms2 = _bar_retry(url)
            if n2 is not None:
                return n2, "地址栏", ms2, "（intent 没落地，改走地址栏）"
            # 报事实，不猜病因：前台是谁、能不能读到浏览器界面，都是可观测的。
            fg = front()
            pk = [n for n in nodes if n.get("packageName") == PKG]
            if fg != PKG:
                die(f"没打开：前台是 {fg}，不是浏览器",
                    "系统禁止后台启动（Minis 不在前台时拉起会被拦）。点一下 X 浏览器图标、再说一次。", code=3)
            if not pk:
                die("没打开：读不到浏览器界面",
                    "只看到状态栏节点——屏幕可能锁着/熄了。亮屏解锁后再说一次。", code=3)
            warn = flag(nodes).strip()
            die(f"没打开：{url} 停在《{title or '空白'}》",
                (warn + "\n  " if warn else "") + "页面本身是空白（不是前台问题，也不是读屏问题）；bw shot 看一眼，或换 bw go 重试。", code=3)
        if not changed and title == prev_title:
            # 页面一个字节都没变、地址栏又读不到 URL —— 无法确认是否打开。
            # 这时**不许报成功、也不许记账**：本机实测过把用户自己的页面记成"我开的"，
            # 下一次 close 就会去关人家的页（2026-11-21）。
            # 地址栏能证明"已经是目标域名"→ 算落地，可以记账
            host = re.sub(r"^[a-z]+://", "", url).split("/")[0]
            # 键盘还没收 = 地址栏浮层（里面就是刚才打的字），不算落地
            # 还要有正文：地址栏显示目标域名、但页面是空的，那是"没加载出来"，不是落地
            # （2026-11-22 实测：一次失败的地址栏输入留下空白页，标题就是 URL，骗过了域名判据）
            if host and not ime_up(nodes) and host in (bar_text(nodes) or "") \
                    and len(text_of(nodes, 10 ** 6)) >= 80:
                note = note or "（页面没重载，但地址栏已是目标域名）"
            elif title:
                # 页面一字节没变、地址栏又读不到 URL → 无法确认。
                # 不许报成功、更不许记账：本机实测过把用户自己的页面记成"我开的"，
                # 下一次 close 就会去关人家的页（2026-11-21）。
                # intent 在"浏览器已在前台"时常常不跳（本机实测）。改走：新建标签 → 地址栏。
                # 这样既不顶掉用户当前页，也能用地址栏真的落地。
                if new_tab and open_new_tab():
                    n3, ms3 = via_bar(url)
                    if n3 is not None:
                        return n3, "新标签+地址栏", ms3, "（intent 没跳，新建标签后走地址栏）"
                die(f"没确认打开：{url} 页面没有任何变化（可能没跳转）",
                    f"再试一次 bw go；或 --new 强制新开。当前页《{title}》我没有记账，close 不会动它。", code=3)
            else:
                note = note or "（内容与上一页相同，可能没真的跳转；不对就 bw go 再来一次）"
    if human_dwell:
        nap(0.5, 1.2)
    return nodes, how, ms, note

_WARNED_INTO = set()

def find_editable(nodes, into=None):
    """找输入框。--into 除了比框自己的文字/描述，还看它上下 80px 里贴着的那句提示词——
    网页的 placeholder 常常是旁边一个独立节点，只比对控件本身永远匹配不上。"""
    eds = [n for n in web_nodes(nodes) if n.get("editable")]
    if not eds:
        return None
    if not into:
        return eds[0]
    texts = [(y, t) for y, _x, t, _n in page_items(nodes)]
    def score(n):
        if into in label(n):
            return 0
        b = n["bounds"]
        for y, t in texts:
            if b["top"] - 90 <= y <= b["bottom"] + 90 and into in t and len(t) <= 30:
                return 1
        return 9
    best = min(eds, key=score)
    if score(best) < 9:
        return best
    print(f"⚠ --into “{into}” 没匹配到任何框，落回第 1 个输入框")
    return eds[0]

def ime_up(nodes=None):
    nodes = nodes if nodes is not None else dump()
    return any("inputmethod" in (n.get("packageName") or "") for n in nodes)

def find_submit_button(nodes, field):
    """同一个输入框旁边、名字像“搜索/提交”的那个按钮。"""
    fb = field["bounds"]
    cands = []
    for n in web_nodes(nodes):
        if not n.get("clickable") or n.get("nodeId") == field.get("nodeId"):
            continue
        t = label(n)
        b = n["bounds"]
        if not t:
            continue
        if re.search(r"^(搜索|Search|查询|提交|前往|发送|Go|确定|登录|Login)$", t) and \
                abs((b["top"] + b["bottom"]) // 2 - (fb["top"] + fb["bottom"]) // 2) < 160:
            cands.append(n)
    return cands[0] if cands else None

def raise_ime(field, wait=1.8):
    """把键盘叫出来。真手指点输入框才弹键盘，无障碍的 ACTION_CLICK 常常只给焦点。"""
    b = field["bounds"]
    a11y("tap", "xy", str((b["left"] + b["right"]) // 2),
         str((b["top"] + b["bottom"]) // 2))
    t0 = time.time()
    while time.time() - t0 < wait:
        if ime_up():
            return True
        time.sleep(0.15)
    return False

def press_ime_enter(y=None):
    """只有键盘真的开着才按这个坐标——关着的话那位置是底部工具栏的“主页”。
    y：键盘“前往/开始”键的纵坐标；不传就用实测默认（H-186，本机 Sogou 的“开始”键）。"""
    if not ime_up():
        return False
    a11y("tap", "xy", str(int(W * 0.92)), str(y if y is not None else H - 186))
    return True

def type_into(text, into=None):
    nodes = dump()
    field = find_editable(nodes, into)
    if not field:
        die("这一屏没有可写的输入框", "先用 bw tap 点一下搜索框，或 bw go 直达 URL")
    if not field.get("focused"):
        b = field["bounds"]
        a11y("tap", "xy", str((b["left"] + b["right"]) // 2), str((b["top"] + b["bottom"]) // 2))
        # 只查两次：焦点要么很快到，要么根本没到（再等也是白等）。原来轮询 1.5s ≈ 最多 12 次 dump。
        for wait in (0.25, 0.15):
            time.sleep(wait)
            nodes = dump()
            f2 = find_editable(nodes, into)
            field = f2 or field
            if f2 and f2.get("focused"):
                break
    nap(0.2, 0.5)
    if HUMAN:                                  # 一段一段敲，不是一次性贴上
        acc, i = "", 0
        while i < len(text):
            step = random.randint(1, 3)
            acc += text[i:i + step]
            a11y("input", "text", acc, "--node", field["nodeId"])
            i += step
            time.sleep(random.uniform(0.07, 0.2))
        got = acc
    else:
        r = a11y("input", "text", text, "--node", field["nodeId"])
        if not r.get("ok"):
            die("写不进输入框 " + str(r.get("error")))
        got = text
    nap(0.15, 0.35)
    # 回读一次：写没写进去要看框里的值，不能只凭 setText 返回 ok（2026-11-23 审计要求）。
    back = [n for n in web_nodes(dump()) if n.get("editable")]
    vals = [ (n.get("text") or "") for n in back ]
    if vals and not any(got in v or v.strip() == got.strip() for v in vals):
        die(f"写不进输入框：框里现在是 {'/'.join(v[:12] or '空' for v in vals[:2])}",
            "可能点到了别的框，或页面重绘把节点换了；bw shot 看一眼再试", code=3)
    return got, field

def do_submit(field, into, timeout=7000):
    """提交并盯结果：键盘的搜索键 → 页面按钮 → 先把键盘叫出来再按。
    谁能真的让页面动起来才算数，不然就继续换下一种。"""
    t0 = time.time()
    total = 0
    nodes = dump()
    plans = []
    if ime_up(nodes):
        plans.append(("键盘搜索键", "ime"))
    btn = find_submit_button(nodes, field)
    if btn:
        plans.append((f"按钮“{label(btn)}”", "btn"))
    if "ime" not in [p[1] for p in plans]:
        plans.append(("键盘搜索键", "ime_raise"))
    last_how = None
    for how, kind in plans:
        nodes = dump()
        if kind in ("ime", "ime_raise"):
            if kind == "ime_raise":
                f2 = find_editable(nodes, into) or field
                if not raise_ime(f2):
                    continue
            if not press_ime_enter():
                continue
        else:
            tap_node(find_submit_button(nodes, field) or btn)
        time.sleep(1.0)                      # 页面切换有个过程，先让它开始动
        nodes, changed, ms = settle(sig(nodes), timeout=timeout, need_chars=300)  # 420 会让短结果页白等 3s
        total = int((time.time() - t0) * 1000)
        last_how = how
        if changed:
            return how, nodes, True, total
        if HUMAN:
            nap(0.3, 0.7)
    return last_how, nodes, False, total

def chip(word, nodes=None):
    """底部/顶部工具栏按钮：文字是空的，只有 contentDesc。"""
    nodes = nodes if nodes is not None else dump()
    for n in nodes:
        if n.get("packageName") == PKG and n.get("clickable") and label(n) == word:
            return n
    return None

def in_tabview(nodes=None):
    """标签面板的唯一可观测标记：面板里有"新建标签"这张卡。
    页面里的正文块几何上与卡片一样（实测 iana 页被当成 6 张卡），只靠几何认会认错。"""
    nodes = nodes if nodes is not None else dump()
    return any(label(n) == "新建标签" for n in nodes)

def open_tabview(wait=0.9, tries=3):
    """进标签面板，**看见"新建标签"才算进去了**。已经在面板里就直接返回 True。"""
    # 键盘没收起来时，底栏被挡住，点"打开的标签"会打到键盘上（2026-11-22 实测）。
    if ime_up():
        a11y("input", "key", "back")
        time.sleep(0.4)
    for _ in range(tries):
        nodes = dump()
        if in_tabview(nodes):
            return True
        n = chip("打开的标签", nodes)
        if not n:
            time.sleep(0.3)
            continue
        tap_node(n)
        t0 = time.time()
        while time.time() - t0 < wait:
            time.sleep(0.25)
            if in_tabview(dump()):
                return True
    return False

def tab_rows(nodes):
    """标签管理里的一张张卡片：标题是卡片里那条长文本。"""
    rows = []
    for n in nodes:
        b = n.get("bounds") or {}
        t = label(n)
        if n.get("packageName") != PKG or not t or n.get("clickable"):
            continue
        if b.get("left", 999) < 260 and b.get("right", 0) - b.get("left", 0) > 400 \
                and TOP - 20 < b.get("top", 0) < BOTTOM:
            rows.append(n)
    return rows

def close_tab_row(nodes, row):
    y = (row["bounds"]["top"] + row["bounds"]["bottom"]) // 2
    xs = [n for n in nodes if n.get("packageName") == PKG and n.get("clickable")
          and n["bounds"]["left"] > 0.80 * W
          and abs((n["bounds"]["top"] + n["bounds"]["bottom"]) // 2 - y) < 60]
    if not xs:
        return False
    b = xs[0]["bounds"]
    # 用坐标点，不用 tap node：nodeId 跨 dump 会变，实测点 nodeId 有时毫无反应
    r = a11y("tap", "xy", str((b["left"] + b["right"]) // 2), str((b["top"] + b["bottom"]) // 2))
    time.sleep(0.55)
    return bool(r.get("ok"))

def _match_count(title, rows=None):
    """面板里和这个标题匹配的卡片有几张（同名两张时是 2）。"""
    rows = tab_rows(dump()) if rows is None else rows
    return sum(1 for r in rows if _title_match(label(r), title))

def _wait_less(title, before, tries=6, wait=0.4):
    """等到匹配这张标题的卡片比 before 少，才算真的关掉一张。
    只数"全屏卡片少了几个"会出事：实测关掉一张后卡片上移，同一个 y 落到下一张，
    连点几次就把别人的卡陆续关掉（2026-11-19 事故）。所以按"这个标题的匹配数"判。"""
    for _ in range(tries):
        if _match_count(title) < before:
            return True
        time.sleep(wait)
    return False

def session_titles():
    st = load_state()
    ts = [t["title"] for t in st["tabs"]]
    if st.get("last") and st["last"] not in ts:
        ts.append(st["last"])
    return ts

def _cards(nodes=None):
    """面板里的卡片。不在面板里就返回空——不许把网页正文当卡片数。
    面板是底部弹层，dump 里同时有网页正文（实测 11 张卡 + 6 段网页文字），
    所以只取"从第一张卡开始、按卡片间距连续排列"的那一串。"""
    nodes = nodes if nodes is not None else dump()
    if not in_tabview(nodes):
        return []
    rows = tab_rows(nodes)
    if not rows:
        return []
    # 卡片判据改成"右侧有一颗 ×"：卡片标题那条文字，同一 y 带上会有一颗靠右的小图标。
    # 以前用"出现最多的 (left,right)"当模板，换机就翻车：本机（1280x2772）网页正文是 L104/R1176
    # 共 6 行、卡片是 L170/R1117 只有 2 行，模板反而选成网页正文（2026-11-21 实测）。
    # × 判据跨机型稳定：图标必须可点、靠右（left > 0.80W）、够小（宽 < 0.15W、高 < 0.08H）。
    xs = [n["bounds"] for n in nodes
          if n.get("packageName") == PKG and n.get("clickable")
          for b in [n.get("bounds") or {}]
          if b.get("left", 0) > 0.80 * W
          and b.get("right", 0) - b.get("left", 0) < 0.15 * W
          and b.get("bottom", 0) - b.get("top", 0) < 0.08 * H]

    def has_x(b):
        y = (b.get("top", 0) + b.get("bottom", 0)) // 2
        return any(abs((x.get("top", 0) + x.get("bottom", 0)) // 2 - y) < 0.05 * H for x in xs)

    rows = [r for r in rows if has_x(r["bounds"]) and label(r) != "新建标签"]
    if not rows:
        return []
    # 再按左右边界收敛一次：网页正文偶尔也会挨着一颗小图标，但它的 left 比卡片更靠边。
    # 在"带 ×"的行里取出现最多的 (left,right)；并列时取 left 更大的那组（卡片有内缩）。
    from collections import Counter
    pairs = Counter((r["bounds"]["left"], r["bounds"]["right"]) for r in rows)
    top_cnt = max(pairs.values())
    cands = [k for k, v in pairs.items() if v == top_cnt]
    pair = max(cands, key=lambda k: k[0])
    rows = sorted([r for r in rows if (r["bounds"]["left"], r["bounds"]["right"]) == pair],
                  key=lambda r: r["bounds"]["top"])
    if not rows:
        return []                               # 只剩磁贴 = 一个标签都没有
    out = [rows[0]]
    for r in rows[1:]:                          # 再按间距断一次：卡片列表中间不会空一大截
        if r["bounds"]["top"] - out[-1]["bounds"]["top"] <= 240:
            out.append(r)
    return out

def _stable_count(tries=3):
    """连续两次读到一样多才算数；动画中途的数字不能用来判断"少了几张"。"""
    last = None
    for _ in range(tries):
        n = len(_cards())
        if last is not None and n == last:
            return n
        last = n
        time.sleep(0.35)
    return last

def _trim(s):
    return (s or "").strip().rstrip("…").strip()

def _title_match(label_txt, title):
    """卡片文字和记账标题是不是同一个页面。三种情况算命中：
    完全相同 / 卡片被截断（卡片是标题的前缀）/ 标题被截断（标题是卡片的前缀且后面不是字母数字）。
    最后那条是用来挡住 "Example Domain" 匹到 "Example Domains" 的。"""
    a, b = _trim(label_txt), _trim(title)
    if not a or not b:
        return False
    if a == b:
        return True
    if b.startswith(a):                      # 卡片被截断
        return True
    if a.startswith(b):                      # 记账被截断
        return len(a) == len(b) or not a[len(b)].isalnum()
    return False

def _row_of(rows, title):
    """卡片里哪一张是这条记录。空标题不按文本认（认不出），交给"总数差"兜底。"""
    if not _trim(title):
        return None
    for r in rows:
        if _title_match(label(r), title):
            return r
    return None

# 关闭动作的安全闸：真机验收通过前只核对不点。
# 验收期间用 BW_CLOSE_FORCE=1 单次强开（不要改成默认 True，除非连续两次真机关闭都对）。
# 2026-11-19 真机连续两次验证通过（10→8、9→8，面板数一致），默认开；
# 想临时禁用：BW_CLOSE_FORCE=0
# 2026-11-19 事故与修复：
#   事故：一次 close 报"关 7 个"，实际连坐关掉用户 5 张卡——根因是按"全屏卡片数变少"判定，
#         关掉一张后卡片上移，同一个 y 又落到下一张，于是被逐个点掉。
#   修复：① 标题严格匹配（"Example Domain" 不再匹到 "Example Domains"）；
#         ② 点完按"这个标题的匹配数少一张"判定，不按全屏总数；
#         ③ 点一下没少就立刻停手，不重试；④ × 用坐标点，不用会失效的 nodeId。
#   验证：桩测 5 例（含前缀陷阱/同名两张/点不动）+ 真机 4 次（每次只关 1 张，其余 6→3 张全是我的）。
# 想临时禁用：BW_CLOSE_FORCE=0
CLOSE_VERIFIED_OK = os.environ.get("BW_CLOSE_FORCE", "1") != "0"

def close_verified(titles, max_taps=40):
    """按记账关标签，**每一步都回读屏幕**：卡片数真的少了才算关掉。
    返回 {status, closed, remaining, before, after}。status ∈ ok / partial / env / noview。
    绝不"点了就当关了"——这正是 "bw close 说关了其实没关" 的第一条根因。"""
    titles = [t for t in titles]
    if front() != PKG and not bring_front():
        return {"status": "env", "closed": [], "remaining": titles, "before": None, "after": None}
    if not open_tabview():
        return {"status": "noview", "closed": [], "remaining": titles, "before": None, "after": None}
    # 再确认一次真的在面板里：本机出现过"open_tabview 说成功了，但屏幕已经被动画/别的动作带回去"，
    # 这时数到的 before 是 0，后面就会把"没看见"当成"我的标签都没了"，把账删光（2026-11-21 事故）。
    if not in_tabview(dump()):
        return {"status": "noview", "closed": [], "remaining": titles, "before": None, "after": None}
    # 卡片要等它画出来：刚切进面板时 dump 可能在动画中，一张都数不到。
    # 数不到就重开一次面板；仍然 0 张 = 这次没看清 → noview，**绝不能**当成"我的标签都不在了"（2026-11-22 复现）。
    before = _stable_count()
    t0 = time.time()
    while before == 0 and time.time() - t0 < 2.5:
        time.sleep(0.35)
        before = _stable_count()
    if before == 0:
        a11y("input", "key", "back")
        if not open_tabview() or not in_tabview(dump()):
            return {"status": "noview", "closed": [], "remaining": titles, "before": None, "after": None}
        t1 = time.time()
        while before == 0 and time.time() - t1 < 2.5:
            time.sleep(0.35)
            before = _stable_count()
        if before == 0:
            a11y("input", "key", "back")
            return {"status": "noview", "closed": [], "remaining": titles, "before": None, "after": None}
    before_names = [label(r) for r in _cards()]
    if not CLOSE_VERIFIED_OK:
        # 真机实测：× 的可点区域未确认，点了可能反而"打开标签"。在确认之前一律不动手。
        a11y("input", "key", "back")
        return {"status": "dry", "closed": [], "remaining": list(dict.fromkeys(titles)),
                "unseen": [], "before": before, "after": before}
    closed, failed, taps = [], [], 0
    for name in dict.fromkeys(titles):           # 同名多条记录 → 一次关一张，循环会再来
        need = titles.count(name)
        got = 0
        tries = 0
        while got < need and taps < max_taps and tries < 3:
            nodes = dump()                         # × 按钮在完整节点里，tab_rows 只返回卡片文字节点
            rows = tab_rows(nodes)
            row = _row_of(rows, name)
            if row is None:
                break                              # 面板里没有这张卡了（关掉了 / 本来就不在）
            seen = label(row)                      # 点之前记下这张卡当时的样子
            before_n = _match_count(name, rows)    # 同名几张：要按"少一张"判
            tries += 1
            if not close_tab_row(nodes, row):
                failed.append(name)
                break
            taps += 1
            if _wait_less(name, before_n):         # 判据：这个标题的匹配数真的少了一张
                closed.append(name)
                got += 1
            else:
                # 没关掉就别再点第二下：上移的卡片会让下一枪打到别人身上
                failed.append(name)
                print(f"… 点了 × 但《{seen[:24]}》还在，停手（不再重试）")
                break
    after = _stable_count()
    after_rows = _cards()
    after_names = [label(r) for r in after_rows]
    # 关前有、关后没了、又不是我关的 → 有东西被误伤（2026-11-19 连坐事故的形状）
    from collections import Counter as _C
    cb, ca, cc = _C(before_names), _C(after_names), _C(closed)
    ghost = []
    for n in set(before_names):                  # 逐标题比数量，避免"标题变了"被误判成误伤
        expect = cb[n] - sum(v for k, v in cc.items() if _title_match(n, k) or _title_match(k, n))
        if ca[n] < max(0, expect):
            ghost.append(f"{n[:20]} 少 {max(0, expect) - ca[n]} 张")
    names = list(dict.fromkeys(titles))
    _cc_tmp = _C(closed)
    still = [t for t in names
             if ca.get(t, 0) > 0 and _cc_tmp.get(t, 0) < cb.get(t, 0)]
    # 找不到 ≠ 已关掉：标签可能在加载中改了标题（实测见过 "Example Domain" → "请稍候…"），
    # 也可能真被手动关掉。分不清就如实分成两栏，别用"已不在"把记录擦掉。
    unseen = [t for t in names if t not in still and t not in closed]
    a11y("input", "key", "back")
    drift = None if (before is None or after is None) else after - (before - len(closed))
    st = "ok" if not still and not unseen else "partial"
    # 只接受"正好少 len(closed) 张"；少了更多说明可能多关了，多了说明别人在开。
    # 两个例外：
    #   ① 关到 0 张时面板自动退出，计数不可靠，按 closed 认定；
    #   ② **关的是当前标签**时，浏览器会自动补一张空白页，卡片数不变（2026-11-22 实测 11→11）。
    #      判据：多出来的那几张正好是空白/主页。
    # 面板一屏只放得下十来张卡，再多就滚动：这时 before/after 天然不可靠，
    # 只认"标题级核对"（_wait_less 已经逐个标题确认少了一张）。2026-11-22 实测 13 个标签只显示 11 张。
    saturated = before is not None and before >= 10
    blanks = ("主页", "新标签页", "搜索或网址", "")
    n_blank = lambda ns: sum(1 for x in ns if x.strip() in blanks)      # noqa: E731
    replaced = (drift is not None and drift > 0
                and n_blank(after_names) - n_blank(before_names) >= drift)
    note = ""
    if saturated:
        note = "（面板满屏，卡片数不可靠；已按标题逐张核对）"
    elif replaced:
        note = "（关的是当前标签，浏览器自动补了一张空白页，所以卡片数没少）"
    suspicious = ((drift is not None and drift != 0 and not (after == 0 and closed)
                   and not replaced and not saturated)
                  or (bool(ghost) and not saturated))
    if suspicious:
        # 2026-11-19 实测踩到：before=5 关了 2 张，after=12（期间冒出 7 张）。
        # 面板数量对不上，说明有别的东西在同一时间开/关标签——这时任何 ✔ 都是猜的。
        st = "changed"
    return {"status": st, "closed": closed, "remaining": still, "unseen": unseen, "note": note,
            "before": before, "after": after, "drift": drift, "ghost": ghost}

@with_lock
def prune_state(closed, remaining, unseen=(), inspected=True, keep=()):
    """只删"核实关掉"的；仍在面板的、以及找不到的，都留着并 tries+1。
    连续 3 次才放弃（放弃必须在输出里说出来）——账本少一条 = 那个标签可能永远关不掉。"""
    st = load_state()
    kept_old = list(st["tabs"])                 # 给 active 找回用（原地改会丢原下标）
    left = {}
    for t in list(remaining) + list(unseen):
        left[t] = left.get(t, 0) + 1
    keep_recs, dropped = [], []
    if not inspected:                      # 没进面板/没核对：账本一个字都不动
        return dropped
    for rec in st["tabs"]:
        t = rec.get("title") or ""
        if any(k in t.lower() for k in (x.lower() for x in keep)):   # --keep 命中的：原样留着，不累加 tries
            keep_recs.append(rec)
            continue
        if closed and t in closed:
            closed.remove(t)                       # 同名多条：关掉几条就删几条
            continue
        if left.get(t, 0) > 0:
            left[t] -= 1
            rec["tries"] = rec.get("tries", 0) + 1
            if rec["tries"] >= 3:
                dropped.append(t)
                continue
            keep_recs.append(rec)                   # 仍在面板里：保留（原来写成了 keep.append，直接丢账）
        else:
            rec["tries"] = rec.get("tries", 0) + 1
            if rec["tries"] >= 3:
                dropped.append(rec.get("title") or "")
                continue
            keep_recs.append(rec)                   # 面板里找不到 ≠ 关掉了：留着，3 次后才放弃
    st["tabs"] = keep_recs
    # active 尽量保住原指向（按标题找回），找不到才退到末条——无条件改末条会让下一次 rename_active 改错记录
    act_title = None
    if isinstance(st.get("active"), int) and 0 <= st["active"] < len(kept_old or []):
        act_title = (kept_old[st["active"]] or {}).get("title")
    st["active"] = next((i for i, r in enumerate(keep_recs) if r.get("title") == act_title),
                        len(keep_recs) - 1 if keep_recs else None)
    st["last"] = keep_recs[-1]["title"] if keep_recs else None
    save_state(st)
    return dropped

# ---------- 子命令 ----------
def cmd_fast(a):
    """只读的活别动屏幕：内置 WebView 取正文，40ms 拿到，不占用户的手机。"""
    url = _url_of(" ".join(a.target))
    t0 = time.time()
    try:
        p = subprocess.run(["minis-browser-use", "navigate", "--url", url],
                           capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        die(f"内置浏览器 60s 没返回", "换外置：bw go <url>", code=2)
    nav = int((time.time() - t0) * 1000)
    try:
        ok_json = json.loads(p.stdout).get("ok") is True
    except Exception:                                          # noqa: BLE001
        ok_json = False
    if not ok_json:
        print(f"✘ 内置浏览器打不开（{p.stdout.strip()[:100]}）——换外置：bw go {url}")
        sys.exit(2)
    r = subprocess.run(["minis-browser-use", "get_readable"], capture_output=True, text=True, timeout=30)
    try:
        txt = json.loads(r.stdout)["data"]["text"]
    except Exception:                                          # noqa: BLE001
        print("✘ 取正文失败：" + (r.stdout.strip()[:120] or r.stderr.strip()[:120]))
        sys.exit(2)
    rd = int((time.time() - t0) * 1000) - nav
    body = txt.strip()
    if body.startswith("Title:"):
        body = body.split("\n", 1)[-1]
