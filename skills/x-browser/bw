def bring_front(wait=3.0, tries=2):
    """把浏览器切到前台。以前这是一条命令，现在只是守卫里的一个动作。
    刚回桌面时系统可能拦一次后台启动，所以重试一次。"""
    for _ in range(tries):
        _open(["intent:#Intent;action=android.intent.action.MAIN;category=android.intent.category.LAUNCHER;"
               "component=" + PKG + "/.BrowserActivity;end"])
        t0 = time.time()
        while time.time() - t0 < wait:
            if front() == PKG:
                return True
            time.sleep(0.15)
    return False

